# ops/aria/.env 로 복사해서 값을 채운다. .env 는 커밋 금지(.gitignore).
# 값은 여기에 적지 않는다. 이름만 둔다.

# 데이터 폴더(스냅샷·증거·SQLite). 비우면 ops/aria/data
ARIA_DATA_DIR=
ARIA_REPO_ROOT=

# 공공데이터포털 '외교부_국가·지역별 입국허가요건' 인증키(일반 인증키, Decoding 값)
MOFA_SERVICE_KEY=
# [재확인] 활용신청 화면의 요청주소. 비우면 config.py 의 기본값(확정 아님)
MOFA_API_URL=

# Firebase (Remote Config·Firestore 전용 서비스 계정 JSON 경로. Hosting 배포 권한은 주지 않는다)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Claude 헤드리스
CLAUDE_BIN=
CLAUDE_DAILY_CAP=
CLAUDE_TIMEOUT_SEC=

# 크롤링 예절
REQUEST_INTERVAL_SEC=
HTTP_TIMEOUT_SEC=

# 공지 페이지 목록: ID|https://주소 를 쉼표로 잇는다
NOTICE_URLS=

# 현장 신호 임계치
FIELD_WINDOW_HOURS=
FIELD_MIN_SAMPLES=
FIELD_MIN_FAILURES=
FIELD_FAIL_RATE=

# 네이버 데이터랩(검색어 트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 관광지 주간 갱신 (run_weekly). Claude 는 CLAUDE_DAILY_CAP(하루)과 이 주간 상한을 함께 본다
ATTRACTIONS_WEEKLY_CAP=
# 증거 폴더(저장소 밖). 비우면 ~/.readyport/evidence (build_attractions.py 와 같은 곳)
ATTRACTIONS_EVIDENCE_DIR=
# PR 을 여는 저장소(owner/name). 비우면 inhyeuk/readyport. 토큰은 git credential.namespace=readyport 에서 꺼낸다(여기 적지 않음)
GITHUB_REPO=
# 이용자 평점: 이 수보다 적으면 숨김(기본 5)
RATINGS_MIN_N=

# 여행 계획 요청 (run_hourly). Firestore 는 서비스 계정 aria-ops(GOOGLE_APPLICATION_CREDENTIALS)
PLAN_DAILY_CAP=
PLAN_TIMEOUT_SEC=
PLAN_MAX_PER_RUN=
# 규칙(firestore.rules)과 같은 값으로: 1인 7일 요청 수(기본 2)
PLAN_COUNTRY_LIMIT=
# 끝난 요청·결과 보관 일수(기본 30)
PLAN_RETENTION_DAYS=
