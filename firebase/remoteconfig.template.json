{
  "parameters": {
    "index_version": {
      "defaultValue": { "value": "2026.09.28-1" },
      "description": "packs/index.json 최신 버전. 이보다 새 것만 받는다",
      "valueType": "STRING"
    },
    "pack_version_TH": {
      "defaultValue": { "value": "2026.09.28-1" },
      "description": "packs/TH/pack.json 최신 버전",
      "valueType": "STRING"
    },
    "recipe_version_TH_TDAC": {
      "defaultValue": { "value": "2026.09.28-1" },
      "description": "packs/recipes/TH_TDAC.json 최신 버전",
      "valueType": "STRING"
    },
    "kill_autofill_TH_TDAC": {
      "defaultValue": { "value": "false" },
      "description": "true면 태국 TDAC 자동 입력을 끄고 수동 모드 (ARIA가 안전한 방향으로만 자동 변경)",
      "valueType": "BOOLEAN"
    },
    "min_app_version": {
      "defaultValue": { "value": "0" },
      "description": "이보다 낮은 versionCode는 업데이트 안내",
      "valueType": "NUMBER"
    },
    "stale_banner": {
      "defaultValue": { "value": "false" },
      "description": "ARIA 점검이 3일 이상 멈추면 true → '정보 점검이 늦어지고 있어요' 배너",
      "valueType": "BOOLEAN"
    }
  }
}
