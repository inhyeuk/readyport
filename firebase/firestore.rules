rules_version = '2';

// 레디포트 Firestore 규칙 (ARCHITECTURE 9.4). 개인정보는 어떤 컬렉션에도 두지 않는다.
// - field_reports: 앱이 익명 실패 리포트를 '생성'만 한다. 읽기·수정·삭제 불가 (ARIA는 Admin SDK로 읽음)
//   expire_at(약 1년 뒤)이 지나면 매월 purge-reports 작업(GitHub Actions)이 지운다 (개인정보처리방침 보관 기간)
// - favorite_counts: 찜 수 +1 만 허용. 읽기는 누구나(순위 계산용 공개 집계)
// - videos/{ISO2}: 나라별 YouTube 여행 영상 목록(서명된 공개 데이터). 앱은 읽기만, 쓰기는 GitHub Actions(서비스 계정)만
// - notices/current: 공지사항(서명된 공개 데이터, docs/NOTICES_PUSH.md). 앱은 문서 하나 읽기(get)만, 목록·쓰기 불가 — 쓰기는 GitHub Actions(notices.yml)만
// - ops/heartbeat: ARIA가 Admin SDK로만 기록. 앱은 접근하지 않는다
// - board_posts·board_users·config/board·config/admins: 게시판(아래 '게시판' 절, docs/BOARD.md) — 공개 글, 익명 로그인 쓰기
// App Check 강제는 Firebase 콘솔에서 켠다 (사람 작업)
service cloud.firestore {
  match /databases/{database}/documents {

    function isId(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen && v.matches('^[A-Za-z0-9_.-]+$');
    }

    match /field_reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(
                         ['form_id', 'pack_version', 'step_id', 'error_code', 'app_version', 'ts', 'expire_at', 'site_version'])
                    && request.resource.data.keys().hasAll(
                         ['form_id', 'pack_version', 'step_id', 'error_code', 'app_version', 'ts', 'expire_at'])
                    && isId(request.resource.data.form_id, 40)
                    && isId(request.resource.data.pack_version, 40)
                    && isId(request.resource.data.step_id, 60)
                    && request.resource.data.error_code in
                         ['selector_missing', 'site_version_changed', 'engine_error', 'manual_mode_chosen', 'kill_switch']
                    && isId(request.resource.data.app_version, 30)
                    && request.resource.data.ts == request.time
                    // 1년 뒤 삭제(purge-reports). 기기 시계 오차를 감안해 335~395일 사이만 받는다
                    && request.resource.data.expire_at is timestamp
                    && request.resource.data.expire_at > request.time + duration.value(335, 'd')
                    && request.resource.data.expire_at < request.time + duration.value(395, 'd')
                    && (!('site_version' in request.resource.data) || isId(request.resource.data.site_version, 60));
    }

    match /favorite_counts/{cityId} {
      allow read: if true;
      allow delete: if false;
      allow create: if isId(cityId, 10)
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    match /videos/{country} {
      allow get: if country.matches('^[A-Z]{2}$');
      allow list, write: if false;
    }

    match /notices/{id} {
      allow get: if true;
      allow list, write: if false;
    }

    // ======================= 게시판 (docs/BOARD.md, 2026-10-08) =======================
    // 레디포트에서 처음으로 **사람이 쓴 글이 서버에 올라가는** 곳 — 누구나 읽는다(로그인 없이). 여권·여행 정보와는 무관하다.
    // 쓰기는 익명 로그인한 사람만, 글쓴이 = 로그인 ID(남을 흉내 낼 수 없다). Cloud Functions가 없으므로 숫자(댓글·추천·신고 수)는
    // 앱이 한 번에 묶어 쓰고, 여기서 getAfter/existsAfter로 '추천 문서가 생기면서 추천 수가 1 오른다' 같은 짝을 확인한다.
    // 글 간격 30초·댓글 간격 10초는 board_users 의 마지막 시각(request.time)으로 막는다.
    // 운영자 = config/admins.uids 에 든 게시판 ID(콘솔에서만 고친다 — 앱은 config/admins 를 쓸 수 없다).

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/admins)
        && me() in get(/databases/$(database)/documents/config/admins).data.uids;
    }
    function text(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function boardCountry(v) { return v in ['', 'TH', 'JP', 'VN', 'PH', 'TW', 'SG', 'MY', 'ID', 'CN']; }
    function postDoc(p) { return /databases/$(database)/documents/board_posts/$(p); }
    function commentDoc(p, c) { return /databases/$(database)/documents/board_posts/$(p)/comments/$(c); }
    function userDoc(u) { return /databases/$(database)/documents/board_users/$(u); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function reportReason(v) { return v in ['spam', 'abuse', 'personal', 'illegal', 'misinfo', 'minor', 'other']; }

    // 사진·동영상: config/board.mediaEnabled 가 켜졌을 때만, 내 Storage 경로(board/{내 ID}/{글 id}/n.jpg|mp4)만, 최대 5개
    function mediaOn() {
      return exists(/databases/$(database)/documents/config/board)
        && get(/databases/$(database)/documents/config/board).data.mediaEnabled == true;
    }
    function mediaUrl(u, postId) {
      return u is string && u.size() < 500
        && u.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/[a-z0-9.-]+/o/board%2F' + me() + '%2F' + postId
                     + '%2F[0-9]+[.](jpg|mp4)[?]alt=media&token=[A-Za-z0-9-]+$');
    }
    function validMedia(m, postId) {
      return m is list && (m.size() == 0 || (mediaOn() && m.size() <= 5
        && mediaUrl(m[0], postId)
        && (m.size() < 2 || mediaUrl(m[1], postId))
        && (m.size() < 3 || mediaUrl(m[2], postId))
        && (m.size() < 4 || mediaUrl(m[3], postId))
        && (m.size() < 5 || mediaUrl(m[4], postId))));
    }

    // 닉네임 2~12자: 한글·영문·숫자·밑줄·가운데 띄어쓰기. 운영자로 보이는 이름은 못 쓴다
    function nickOk(n) {
      return text(n, 2, 12) && n.matches('^[가-힣A-Za-z0-9_ ]+$') && !n.matches('^ .*|.* $|.*  .*')
        && !n.lower().replace(' ', '').matches('.*(운영자|관리자|admin|레디포트|readyport|운영팀|official).*');
    }

    // ---------------- 게시판 이용자 board_users/{uid} — 닉네임·간격 확인용 시각만 ----------------
    function userKeys() {
      return ['nickname', 'createdAt', 'postCount', 'lastPostAt', 'lastPostId', 'lastCommentAt', 'lastCommentPost', 'lastCommentId'];
    }
    // 마지막 글 시각은 '그대로'이거나 '지금 + 같은 묶음에서 그 글이 새로 생김'만
    function userPostFieldsOk() {
      let a = request.resource.data;
      let b = resource.data;
      return (a.get('lastPostAt', null) == b.get('lastPostAt', null)
              && a.get('lastPostId', null) == b.get('lastPostId', null) && a.postCount == b.postCount)
        || (a.lastPostAt == request.time && a.postCount == b.postCount + 1 && a.lastPostId is string
            && !exists(postDoc(a.lastPostId)) && existsAfter(postDoc(a.lastPostId)));
    }
    function userCommentFieldsOk() {
      let a = request.resource.data;
      let b = resource.data;
      return (a.get('lastCommentAt', null) == b.get('lastCommentAt', null)
              && a.get('lastCommentPost', null) == b.get('lastCommentPost', null)
              && a.get('lastCommentId', null) == b.get('lastCommentId', null))
        || (a.lastCommentAt == request.time && a.lastCommentPost is string && a.lastCommentId is string
            && !exists(commentDoc(a.lastCommentPost, a.lastCommentId))
            && existsAfter(commentDoc(a.lastCommentPost, a.lastCommentId)));
    }

    match /board_users/{uid} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['nickname', 'createdAt', 'postCount'])
        && request.resource.data.keys().hasAll(['nickname', 'createdAt', 'postCount'])
        && nickOk(request.resource.data.nickname)
        && request.resource.data.createdAt == request.time
        && request.resource.data.postCount == 0;
      allow update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(userKeys())
        && request.resource.data.createdAt == resource.data.createdAt
        && nickOk(request.resource.data.nickname)
        && userPostFieldsOk() && userCommentFieldsOk();
      allow delete: if signedIn() && uid == me();
    }

    // ---------------- 게시글 board_posts/{postId} ----------------
    function postKeys() {
      return ['kind', 'title', 'body', 'country', 'keywords', 'media', 'authorUid', 'nickname', 'createdAt', 'updatedAt',
              'lastCommentAt', 'lastCommentId', 'commentCount', 'likeCount', 'reportCount', 'score', 'solved', 'acceptedId',
              'pinned', 'hidden', 'deleted'];
    }
    // 30초 간격: 내 이용자 문서의 lastPostAt 이 같은 묶음에서 지금으로 바뀌고, 그 전 값은 30초보다 오래됐다
    function postRateOk(postId) {
      let before = get(userDoc(me())).data;
      let after = getAfter(userDoc(me())).data;
      return after.lastPostAt == request.time && after.lastPostId == postId
        && (!('lastPostAt' in before) || request.time > before.lastPostAt + duration.value(30, 's'));
    }
    function newPostOk(postId) {
      let d = request.resource.data;
      return signedIn() && d.keys().hasOnly(postKeys()) && d.keys().hasAll(postKeys())
        && d.kind in ['qna', 'talk'] && d.authorUid == me()
        && text(d.title, 4, 60) && text(d.body, 10, 3000) && boardCountry(d.country)
        && d.keywords is list && d.keywords.size() <= 40 && validMedia(d.media, postId)
        && d.createdAt == request.time && d.updatedAt == request.time && d.lastCommentAt == request.time
        && d.lastCommentId == ''
        && d.commentCount == 0 && d.likeCount == 0 && d.reportCount == 0 && d.score == 0
        && d.solved == false && d.acceptedId == '' && d.pinned == false && d.hidden == false && d.deleted == false
        && exists(userDoc(me())) && d.nickname == getAfter(userDoc(me())).data.nickname
        && postRateOk(postId);
    }
    function authorEditOk(postId) {
      let d = request.resource.data;
      return resource.data.authorUid == me() && resource.data.deleted == false
        && changed().hasOnly(['title', 'body', 'country', 'keywords', 'media', 'updatedAt'])
        && text(d.title, 4, 60) && text(d.body, 10, 3000) && boardCountry(d.country)
        && d.keywords is list && d.keywords.size() <= 40
        && (d.media == resource.data.media || validMedia(d.media, postId))
        && d.updatedAt == request.time;
    }
    // 글쓴이가 지우기(댓글이 있을 때): 글만 비우고 댓글 묶음은 남긴다
    function authorSoftDeleteOk() {
      let d = request.resource.data;
      return resource.data.authorUid == me() && resource.data.deleted == false
        && changed().hasOnly(['deleted', 'title', 'body', 'country', 'keywords', 'media', 'nickname', 'updatedAt'])
        && d.deleted == true && d.title == '' && d.body == '' && d.country == '' && d.keywords.size() == 0
        && d.media.size() == 0 && d.nickname == '' && d.updatedAt == request.time;
    }
    // 추천 수·인기 점수는 내 추천 문서가 생길 때 +1, 없어질 때 -1 (자기 글은 추천할 수 없다)
    function postLikeOk(postId) {
      let d = request.resource.data;
      let like = /databases/$(database)/documents/board_posts/$(postId)/likes/$(me());
      return changed().hasOnly(['likeCount', 'score'])
        && ((d.likeCount == resource.data.likeCount + 1 && d.score == resource.data.score + 1
              && resource.data.authorUid != me() && resource.data.deleted == false
              && !exists(like) && existsAfter(like))
          || (d.likeCount == resource.data.likeCount - 1 && d.score == resource.data.score - 1
              && exists(like) && !existsAfter(like)));
    }
    // 신고 수는 내 신고 문서가 새로 생길 때만 +1 (한 사람 한 번)
    function postReportOk(postId) {
      let r = /databases/$(database)/documents/board_posts/$(postId)/reports/$(me());
      return changed().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && resource.data.authorUid != me()
        && !exists(r) && existsAfter(r);
    }
    // 댓글 수·인기 점수는 같은 묶음에서 새 댓글(lastCommentId)이 생길 때만 +1
    function commentAddedOk(postId) {
      let d = request.resource.data;
      return resource.data.deleted == false && resource.data.hidden == false
        && changed().hasOnly(['commentCount', 'score', 'lastCommentAt', 'lastCommentId'])
        && d.commentCount == resource.data.commentCount + 1 && d.score == resource.data.score + 1
        && d.lastCommentAt == request.time && d.lastCommentId is string && d.lastCommentId.size() > 0
        && !exists(commentDoc(postId, d.lastCommentId)) && existsAfter(commentDoc(postId, d.lastCommentId));
    }
    // Q&A 채택: 질문한 사람만, 남이 쓴 맨 위 답(답글이 아닌) 하나. 풀기도 된다
    function acceptOk(postId) {
      let d = request.resource.data;
      return resource.data.authorUid == me() && resource.data.kind == 'qna' && resource.data.deleted == false
        && changed().hasOnly(['solved', 'acceptedId'])
        && ((d.solved == false && d.acceptedId == '')
          || (d.solved == true && d.acceptedId is string && d.acceptedId.size() > 0
              && exists(commentDoc(postId, d.acceptedId))
              && get(commentDoc(postId, d.acceptedId)).data.parentId == ''
              && get(commentDoc(postId, d.acceptedId)).data.authorUid != me()
              && get(commentDoc(postId, d.acceptedId)).data.deleted == false));
    }
    // 운영자: 고정·가림(임시조치)·신고 수 0으로(검토 끝)
    function adminPostOk() {
      let d = request.resource.data;
      return isAdmin() && changed().hasOnly(['pinned', 'hidden', 'reportCount'])
        && d.pinned is bool && d.hidden is bool
        && (d.reportCount == resource.data.reportCount || d.reportCount == 0);
    }

    match /board_posts/{postId} {
      // 가린 글은 운영자와 글쓴이만 (목록 질의는 hidden == false 를 걸어야 통과한다)
      allow get: if resource == null || resource.data.hidden == false || isAdmin()
        || (signedIn() && resource.data.authorUid == me());
      allow list: if resource.data.hidden == false || isAdmin()
        || (signedIn() && resource.data.authorUid == me());
      allow create: if newPostOk(postId);
      allow update: if signedIn() && (authorEditOk(postId) || authorSoftDeleteOk() || postLikeOk(postId)
        || postReportOk(postId) || commentAddedOk(postId) || acceptOk(postId) || adminPostOk());
      // 글쓴이는 댓글이 없을 때만 문서째 지운다(있으면 비우기). 운영자는 언제나
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorUid == me() && resource.data.commentCount == 0);

      match /likes/{uid} {
        allow get: if signedIn() && uid == me();
        allow list, update: if false;
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'postId', 'at'])
          && request.resource.data.keys().hasAll(['uid', 'postId', 'at'])
          && request.resource.data.uid == me() && request.resource.data.postId == postId
          && request.resource.data.at == request.time
          && getAfter(postDoc(postId)).data.likeCount == get(postDoc(postId)).data.likeCount + 1;
        allow delete: if signedIn() && uid == me()
          && getAfter(postDoc(postId)).data.likeCount == get(postDoc(postId)).data.likeCount - 1;
      }

      // 신고 문서는 운영자만 읽는다(누가 신고했는지 공개하지 않는다). 본인은 '이미 신고했어요'를 알 수 있게 자기 것만
      match /reports/{uid} {
        allow get: if signedIn() && (uid == me() || isAdmin());
        allow list: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'reason', 'at'])
          && request.resource.data.keys().hasAll(['uid', 'reason', 'at'])
          && request.resource.data.uid == me() && reportReason(request.resource.data.reason)
          && request.resource.data.at == request.time
          && getAfter(postDoc(postId)).data.reportCount == get(postDoc(postId)).data.reportCount + 1;
      }

      // ---------------- 댓글 board_posts/{postId}/comments/{commentId} ----------------
      match /comments/{commentId} {
        allow get: if resource == null || resource.data.hidden == false || isAdmin()
          || (signedIn() && resource.data.authorUid == me());
        allow list: if resource.data.hidden == false || isAdmin()
          || (signedIn() && resource.data.authorUid == me());
        allow create: if newCommentOk(postId, commentId);
        allow update: if signedIn() && (commentEditOk() || commentSoftDeleteOk() || commentLikeOk(postId, commentId)
          || commentReportOk(postId, commentId) || adminCommentOk());
        allow delete: if isAdmin();

        match /likes/{uid} {
          allow get: if signedIn() && uid == me();
          allow list, update: if false;
          allow create: if signedIn() && uid == me()
            && request.resource.data.keys().hasOnly(['uid', 'postId', 'at'])
            && request.resource.data.keys().hasAll(['uid', 'postId', 'at'])
            && request.resource.data.uid == me() && request.resource.data.postId == postId
            && request.resource.data.at == request.time
            && getAfter(commentDoc(postId, commentId)).data.likeCount == get(commentDoc(postId, commentId)).data.likeCount + 1;
          allow delete: if signedIn() && uid == me()
            && getAfter(commentDoc(postId, commentId)).data.likeCount == get(commentDoc(postId, commentId)).data.likeCount - 1;
        }

        match /reports/{uid} {
          allow get: if signedIn() && (uid == me() || isAdmin());
          allow list: if isAdmin();
          allow update: if false;
          allow delete: if isAdmin();
          allow create: if signedIn() && uid == me()
            && request.resource.data.keys().hasOnly(['uid', 'reason', 'at'])
            && request.resource.data.keys().hasAll(['uid', 'reason', 'at'])
            && request.resource.data.uid == me() && reportReason(request.resource.data.reason)
            && request.resource.data.at == request.time
            && getAfter(commentDoc(postId, commentId)).data.reportCount == get(commentDoc(postId, commentId)).data.reportCount + 1;
        }
      }
    }

    function commentKeys() {
      return ['postId', 'postAuthorUid', 'authorUid', 'nickname', 'body', 'parentId', 'replyToId', 'replyToUid', 'replyToNick',
              'notify', 'createdAt', 'updatedAt', 'edited', 'likeCount', 'reportCount', 'deleted', 'hidden'];
    }
    // 10초 간격: 내 이용자 문서의 lastCommentAt 이 같은 묶음에서 지금으로 바뀌고, 그 전 값은 10초보다 오래됐다
    function commentRateOk(postId, commentId) {
      let before = get(userDoc(me())).data;
      let after = getAfter(userDoc(me())).data;
      return after.lastCommentAt == request.time && after.lastCommentPost == postId && after.lastCommentId == commentId
        && (!('lastCommentAt' in before) || request.time > before.lastCommentAt + duration.value(10, 's'));
    }
    // 답글은 한 단계: parentId 는 맨 위 댓글. replyToId 는 그 묶음의 댓글(맨 위 또는 답글)이고 알림 대상·닉네임이 그 댓글과 같다
    function replyOk(postId, d) {
      return (d.parentId == '' && d.replyToId == '' && d.replyToUid == '' && d.replyToNick == '')
        || (d.parentId is string && d.parentId.size() > 0
            && exists(commentDoc(postId, d.parentId))
            && get(commentDoc(postId, d.parentId)).data.parentId == ''
            && d.replyToId is string && d.replyToId.size() > 0
            && exists(commentDoc(postId, d.replyToId))
            && (d.replyToId == d.parentId || get(commentDoc(postId, d.replyToId)).data.parentId == d.parentId)
            && d.replyToUid == get(commentDoc(postId, d.replyToId)).data.authorUid
            && d.replyToNick == get(commentDoc(postId, d.replyToId)).data.nickname);
    }
    function newCommentOk(postId, commentId) {
      let d = request.resource.data;
      let post = get(postDoc(postId)).data;
      return signedIn() && d.keys().hasOnly(commentKeys()) && d.keys().hasAll(commentKeys())
        && d.authorUid == me() && d.postId == postId && d.postAuthorUid == post.authorUid
        && post.hidden == false && post.deleted == false
        && text(d.body, 1, 1000)
        && d.createdAt == request.time && d.updatedAt == request.time && d.edited == false
        && d.likeCount == 0 && d.reportCount == 0 && d.deleted == false && d.hidden == false
        && replyOk(postId, d)
        // 알림 받을 사람은 글쓴이·답글 대상 중에서만(아무에게나 알림을 보낼 수 없다), 자기 자신은 빼고
        && d.notify is list && d.notify.size() <= 2 && !(me() in d.notify)
        && d.notify.toSet().difference([d.postAuthorUid, d.replyToUid].toSet()).size() == 0
        && exists(userDoc(me())) && d.nickname == getAfter(userDoc(me())).data.nickname
        && getAfter(postDoc(postId)).data.commentCount == post.commentCount + 1
        && getAfter(postDoc(postId)).data.lastCommentId == commentId
        && commentRateOk(postId, commentId);
    }
    function commentEditOk() {
      return resource.data.authorUid == me() && resource.data.deleted == false
        && changed().hasOnly(['body', 'edited', 'updatedAt'])
        && text(request.resource.data.body, 1, 1000) && request.resource.data.edited == true
        && request.resource.data.updatedAt == request.time;
    }
    function commentSoftDeleteOk() {
      let d = request.resource.data;
      return resource.data.authorUid == me() && resource.data.deleted == false
        && changed().hasOnly(['deleted', 'body', 'nickname', 'updatedAt'])
        && d.deleted == true && d.body == '' && d.nickname == '' && d.updatedAt == request.time;
    }
    function commentLikeOk(postId, commentId) {
      let d = request.resource.data;
      let like = /databases/$(database)/documents/board_posts/$(postId)/comments/$(commentId)/likes/$(me());
      return changed().hasOnly(['likeCount'])
        && ((d.likeCount == resource.data.likeCount + 1 && resource.data.authorUid != me() && resource.data.deleted == false
              && !exists(like) && existsAfter(like))
          || (d.likeCount == resource.data.likeCount - 1 && exists(like) && !existsAfter(like)));
    }
    function commentReportOk(postId, commentId) {
      let r = /databases/$(database)/documents/board_posts/$(postId)/comments/$(commentId)/reports/$(me());
      return changed().hasOnly(['reportCount'])
        && request.resource.data.reportCount == resource.data.reportCount + 1
        && resource.data.authorUid != me()
        && !exists(r) && existsAfter(r);
    }
    function adminCommentOk() {
      return isAdmin() && changed().hasOnly(['hidden', 'reportCount'])
        && request.resource.data.hidden is bool
        && (request.resource.data.reportCount == resource.data.reportCount || request.resource.data.reportCount == 0);
    }

    // 묶음 질의(collection group): 답글 알림(내게 온 댓글)·내 기록 지우기(내 댓글·내 추천)·운영자 신고 목록
    match /{path=**}/comments/{commentId} {
      allow list: if resource.data.hidden == false || isAdmin()
        || (signedIn() && resource.data.authorUid == me());
    }
    match /{path=**}/likes/{likeId} {
      allow list: if signedIn() && resource.data.uid == me();
    }

    // ---------------- 운영 설정 ----------------
    // 운영자 목록: 앱은 읽기만(내가 운영자인지 보려고). 고치기는 Firebase 콘솔에서만 — 앱의 어떤 요청도 못 쓴다
    match /config/admins {
      allow get: if true;
      allow list, write: if false;
    }
    // 사진·동영상 올리기 스위치: 운영자만 바꾼다(기본 꺼짐 — 문서가 없으면 꺼짐)
    match /config/board {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['mediaEnabled', 'updatedAt'])
        && request.resource.data.keys().hasAll(['mediaEnabled', 'updatedAt'])
        && request.resource.data.mediaEnabled is bool
        && request.resource.data.updatedAt == request.time;
    }

    // ======================= 관광지 평점·확인 중 표시 (사장님 결정 2026-10-09 ①, docs/ARIA_OPS.md 12.10) =======================
    // 별점 한 표 = attraction_ratings/{CC}_{관광지 id}/votes/{uid}. 한 사람 한 표(문서 id = 내 ID), 자유 글 없음.
    // 만 19세 확인은 서버가 할 수 없다 — 앱이 게시판과 같은 기준(여권 생년월일, 기기 안 판정)으로 쓰기 화면을 막는다.
    // 집계(attraction_rating_stats)·확인 중 표시(attraction_flags)는 ARIA 서비스 계정만 쓴다(서비스 계정은 규칙을 거치지 않는다).
    function ratingKey(k) {
      return k is string && k.size() <= 90
        && k.matches('^(TH|JP|VN|PH|TW|SG|MY|ID|CN)_[a-z0-9]+(-[a-z0-9]+)*$');
    }
    function voteOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['stars', 'at', 'visited']) && d.keys().hasAll(['stars', 'at', 'visited'])
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && d.visited == true && d.at == request.time;
    }
    match /attraction_ratings/{key} {
      allow read, write: if false;
      match /votes/{uid} {
        allow get: if signedIn() && uid == me();
        allow list: if false;
        allow create, update: if signedIn() && uid == me() && ratingKey(key) && voteOk();
        allow delete: if signedIn() && uid == me();
      }
    }
    match /attraction_rating_stats/{country} {
      allow get: if country.matches('^(TH|JP|VN|PH|TW|SG|MY|ID|CN)$');
      allow list, write: if false;
    }
    match /attraction_flags/{country} {
      allow get: if country.matches('^(TH|JP|VN|PH|TW|SG|MY|ID|CN)$');
      allow list, write: if false;
    }

    // ======================= 여행 계획 요청 (사장님 결정 2026-10-09 ②, docs/ARIA_OPS.md 12.11) =======================
    // 비공개: 요청·결과는 본인과 운영자(config/admins)만 읽는다. 처리·결과 쓰기는 ARIA 서비스 계정(규칙 밖)만.
    // 이동 조건(mobility)은 민감정보(개인정보 보호법 제23조) — 선택형만, 고르면 sensitive_consent == true 필수(별도 동의).
    // 1인 7일 2회: plan_quota/{uid} {last, prev, lastRequestId} 를 요청과 같은 묶음(batch)에서 고쳐야 한다.
    //   새 요청 시각 = last, 직전 last = prev. 직전 prev 가 7일 안이면(= 이미 7일에 2번) 막는다.
    //   익명 계정이라 앱을 지우고 다시 깔면 새 ID 가 되는 한계는 남는다(ARIA 가 다시 세지만 같은 ID 기준).
    // 이용자는 고칠 수 없고 취소(status → cancelled)만 된다. 취소한 요청은 이용자가 '삭제'를 누를 때까지 그대로 남고
    // (2026-10-09 사장님 결정 — 자동 삭제하지 않음), 본인이 지울 수 있다. 끝난(done·failed) 요청은 ARIA 정리 작업이 30일 뒤 지운다.
    function planCountry(v) { return v in ['TH', 'JP', 'VN', 'PH', 'TW', 'SG', 'MY', 'ID', 'CN']; }
    function planDoc(id) { return /databases/$(database)/documents/plan_requests/$(id); }
    function quotaDoc(u) { return /databases/$(database)/documents/plan_quota/$(u); }
    function smallCount(v) { return v is int && v >= 0 && v <= 20; }
    function travelersOk(t) {
      return t is map && t.keys().hasOnly(['adults', 'seniors', 'teens', 'children', 'genders'])
        && t.keys().hasAll(['adults', 'seniors', 'teens', 'children'])
        && smallCount(t.adults) && smallCount(t.seniors) && smallCount(t.teens) && smallCount(t.children)
        && t.adults + t.seniors + t.teens + t.children >= 1 && t.adults + t.seniors + t.teens + t.children <= 20
        && (!('genders' in t) || (t.genders is map && t.genders.keys().hasOnly(['female', 'male'])
             && (!('female' in t.genders) || smallCount(t.genders.female))
             && (!('male' in t.genders) || smallCount(t.genders.male))));
    }
    function purposesOk(p) {
      return p is list && p.size() >= 1 && p.size() <= 5 && p.toSet().size() == p.size()
        && p.toSet().difference(['sightseeing', 'food', 'shopping', 'nature', 'history_culture', 'relaxation',
                                 'kids_family', 'activity', 'other'].toSet()).size() == 0;
    }
    function mobilityOk(d) {
      let m = d.get('mobility', []);
      return m is list && m.size() <= 5
        && m.toSet().difference(['long_walk_hard', 'wheelchair', 'stairs_hard', 'with_infant', 'other_none'].toSet()).size() == 0
        && (m.size() == 0 ? !('sensitive_consent' in d) : d.get('sensitive_consent', false) == true);
    }
    function datesOk(d) {
      return ('days' in d && !('start_date' in d) && !('end_date' in d) && d.days is int && d.days >= 1 && d.days <= 30)
        || (!('days' in d) && d.start_date is string && d.end_date is string
            && d.start_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.end_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.end_date >= d.start_date);
    }
    function newPlanOk(id) {
      let d = request.resource.data;
      let q = getAfter(quotaDoc(me())).data;
      return signedIn() && isId(id, 40)
        && d.keys().hasOnly(['uid', 'country', 'purposes', 'purpose_note', 'travelers', 'mobility', 'sensitive_consent',
                             'start_date', 'end_date', 'days', 'budget_band', 'currency', 'status', 'createdAt'])
        && d.keys().hasAll(['uid', 'country', 'purposes', 'travelers', 'budget_band', 'currency', 'status', 'createdAt'])
        && d.uid == me() && planCountry(d.country) && purposesOk(d.purposes)
        && (!('purpose_note' in d) || text(d.purpose_note, 1, 200))
        && travelersOk(d.travelers) && mobilityOk(d) && datesOk(d)
        && d.budget_band in ['budget', 'standard', 'comfort', 'premium'] && d.currency == 'KRW'
        && d.status == 'queued' && d.createdAt == request.time
        // 같은 묶음에서 내 횟수 기록이 이 요청으로 바뀌어야 한다
        && q.last == request.time && q.lastRequestId == id;
    }
    match /plan_requests/{id} {
      allow get: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow list: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow create: if newPlanOk(id);
      // 이용자는 취소만: queued·processing 일 때 status → cancelled, finishedAt = 지금
      allow update: if signedIn() && resource.data.uid == me()
        && resource.data.status in ['queued', 'processing']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt'])
        && request.resource.data.status == 'cancelled' && request.resource.data.finishedAt == request.time;
      // 끝난 내 요청(취소·완료·실패)은 지울 수 있다 — 2026-10-09 사장님 결정. 처리 중인 것은 먼저 취소.
      // 횟수 기록 plan_quota 는 그대로(지워도 주 2회 제한은 풀리지 않는다)
      allow delete: if signedIn() && resource.data.uid == me() && resource.data.status in ['cancelled', 'done', 'failed'];
    }
    match /plan_quota/{uid} {
      allow get: if signedIn() && uid == me();
      allow list, delete: if false;
      // 첫 요청
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['last', 'prev', 'lastRequestId'])
        && request.resource.data.keys().hasAll(['last', 'prev', 'lastRequestId'])
        && request.resource.data.last == request.time && request.resource.data.prev == null
        && isId(request.resource.data.lastRequestId, 40)
        && !exists(planDoc(request.resource.data.lastRequestId))
        && existsAfter(planDoc(request.resource.data.lastRequestId));
      // 다음 요청: 직전 prev 가 7일보다 오래됐을 때만(7일에 2번까지)
      allow update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['last', 'prev', 'lastRequestId'])
        && request.resource.data.last == request.time
        && request.resource.data.prev == resource.data.last
        && (resource.data.prev == null || resource.data.prev < request.time - duration.value(7, 'd'))
        && isId(request.resource.data.lastRequestId, 40)
        && !exists(planDoc(request.resource.data.lastRequestId))
        && existsAfter(planDoc(request.resource.data.lastRequestId));
    }
    match /plan_results/{id} {
      allow get: if resource == null || (signedIn() && resource.data.uid == me()) || isAdmin();
      allow list: if (signedIn() && resource.data.uid == me()) || isAdmin();
      allow create, update: if false;
      // 내 계획 결과는 내가 지울 수 있다(요청을 지울 때 함께)
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---------------- AI 계획 신고 plan_flags/{requestId} (Play 'AI 생성 콘텐츠' 정책: 앱 안에서 신고) ----------------
    // 내 계획 결과(plan_results/{id}.uid == 나)에만, 계획 하나에 한 번(문서 id = 요청 id — 두 번째 쓰기는 update 라 거절).
    // 칸: uid·reason(4가지)·note(선택, 1~200자)·at(서버 시각). 이용자는 고치거나 지울 수 없고 읽지도 못한다(운영자만).
    // 지우기는 ARIA 정리 작업(서비스 계정, 규칙 밖)만: 요청·결과가 30일 정리로 지워질 때 함께, 이용자가 요청을 지우면 다음 정리 때.
    function flagReason(v) { return v in ['inaccurate', 'inappropriate', 'unsafe', 'other']; }
    function resultDoc(id) { return /databases/$(database)/documents/plan_results/$(id); }
    match /plan_flags/{id} {
      allow get, list: if isAdmin();
      allow update, delete: if false;
      allow create: if signedIn() && isId(id, 40)
        && exists(resultDoc(id)) && get(resultDoc(id)).data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'reason', 'note', 'at'])
        && request.resource.data.keys().hasAll(['uid', 'reason', 'at'])
        && request.resource.data.uid == me()
        && flagReason(request.resource.data.reason)
        && (!('note' in request.resource.data) || text(request.resource.data.note, 1, 200))
        && request.resource.data.at == request.time;
    }

    // 그 밖의 모든 경로(ops/heartbeat 포함)는 앱에서 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
