{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyport-app.web.app/schema/notices.schema.json",
  "title": "레디포트 공지 원본 (notices/notices.json)",
  "description": "사람이 PR로 고치는 원본(서명 없음). tools/notices/build_notices.py 가 이 스키마와 추가 규칙(주소 허용 목록·대체 글·기간·광고 표시)을 검사한 뒤 서명해 Firestore notices/current 에 올린다. 앱은 서명이 맞는 것만 보여 준다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "notices"],
  "properties": {
    "schema_version": {"const": 1},
    "notices": {
      "type": "array",
      "maxItems": 30,
      "items": {"$ref": "#/$defs/notice"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "active", "type", "title_ko", "body_ko", "start"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,40}$", "description": "바꾸지 않는 이름. 앱은 id@version 으로 '다시 보지 않기'를 기억한다"},
        "version": {"type": "integer", "minimum": 1, "description": "내용을 크게 고치면 올린다 → '다시 보지 않기'를 누른 사람에게도 다시 보인다"},
        "active": {"type": "boolean", "description": "false 면 서명본에 넣지 않는다(초안)"},
        "type": {"enum": ["urgent", "normal", "event", "guide"]},
        "category": {"enum": ["service", "promo"], "default": "service", "description": "promo = 광고성 정보(정보통신망법 제50조): 제목이 (광고)로 시작, 받기에 동의한 사람에게만 알림"},
        "title_ko": {"$ref": "#/$defs/text", "maxLength": 40},
        "body_ko": {"$ref": "#/$defs/text", "maxLength": 500},
        "more_pages_ko": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/text", "maxLength": 500}},
        "images": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "alt_ko"],
            "properties": {
              "url": {"type": "string", "pattern": "^https://readyport-app\\.web\\.app/notices/[A-Za-z0-9_./-]+\\.(png|webp|jpg)$"},
              "alt_ko": {"$ref": "#/$defs/text", "maxLength": 300, "description": "TalkBack이 읽는 글. 그림이 안 열릴 때도 이 글을 보인다"}
            }
          }
        },
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label_ko", "url"],
          "properties": {
            "label_ko": {"$ref": "#/$defs/text", "maxLength": 24},
            "url": {"type": "string", "pattern": "^https://"}
          }
        },
        "start": {"type": "string", "description": "ISO 날짜·시각 + 시간대 (예: 2026-10-20T09:00:00+09:00)"},
        "end": {"type": "string"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000, "default": 0},
        "min_version_code": {"type": "integer", "minimum": 1},
        "max_version_code": {"type": "integer", "minimum": 1},
        "audience": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^(all|[A-Z]{2})$"},
          "description": "[\"all\"] 또는 나라 코드 목록 — 그 나라를 여행으로 만들었거나 찜한 기기에서만 보인다(판단은 기기 안에서만)"
        }
      }
    }
  }
}
