<?xml version="1.0" encoding="utf-8"?>
<!--
  UI 문구는 쉬운 말 사전(PRD 3.4)을 따른다. 중학교 1학년 수준 어휘, 전문 용어는 괄호로만 병기.
  ETA → 미리 받는 입국 허락 / 입국신고서 → 도착 전에 내는 입국 카드 / 세관 → 가방 속 물건을 확인하는 곳
  체크인 → 비행기 표 받고 짐 맡기기 / 승인 → "맞아요, 입력해 주세요"
-->
<resources>
    <string name="app_name">레디포트</string>

    <!-- 하단 탭 -->
    <string name="tab_today">오늘</string>
    <string name="tab_prepare">준비</string>
    <string name="tab_explore">여행지</string>
    <string name="tab_wallet">지갑</string>
    <string name="tab_help">도움</string>

    <!-- 공통 -->
    <string name="action_home">처음으로</string>
    <string name="action_listen">소리로 듣기</string>
    <string name="action_settings">설정</string>
    <string name="coming_soon">준비 중이에요</string>
    <string name="source_footer">출처 %1$s · 최종 확인 %2$s</string>

    <!-- 첫 실행 -->
    <string name="first_run_title">해외여행이 처음이세요?</string>
    <string name="first_run_body">처음이시면 글자와 버튼을 크게 하고, 한 화면에 할 일을 하나씩 보여 드려요. 설정에서 언제든 바꿀 수 있어요.</string>
    <string name="first_run_yes">네, 처음이에요</string>
    <string name="first_run_no">아니요, 가 봤어요</string>

    <!-- 오늘 -->
    <string name="today_title">오늘 할 일</string>
    <string name="today_no_trip">아직 만든 여행이 없어요</string>
    <string name="today_stage_desc">여행 단계: %1$s (%3$d단계 중 %2$d단계)</string>
    <string name="today_stage_now">지금: %1$s (%3$d단계 중 %2$d단계)</string>
    <string name="stage_prepare">준비</string>
    <string name="stage_departure">출국</string>
    <string name="stage_arrival">도착</string>
    <string name="stage_traveling">여행 중</string>
    <string name="stage_return">귀국</string>
    <string name="stage_wrapup">정리</string>
    <string name="today_next_label">지금 할 일</string>
    <string name="today_next_title">어디로 여행 가세요?</string>
    <string name="today_next_body">가고 싶은 곳을 찜하면 필요한 서류와 준비물을 알려 드려요.</string>
    <string name="today_next_button">여행지 고르기</string>
    <string name="today_help_title">급할 때는 \'도움\'을 누르세요</string>
    <string name="today_help_body">현지어 문장 카드와 긴급 연락처는 인터넷이 없어도 볼 수 있어요.</string>
    <string name="today_speech">오늘 할 일. 아직 만든 여행이 없어요. 지금 할 일은 여행지 고르기예요.</string>

    <!-- 준비 -->
    <string name="prepare_title">여행 준비</string>
    <string name="prepare_subtitle">서류와 준비물을 하나씩 챙겨요</string>
    <string name="prepare_disclaimer">레디포트는 정부 기관과 제휴하지 않았어요. 공식 사이트 화면을 그대로 보여 드리고, 마지막 제출은 직접 해요.</string>
    <string name="prepare_forms_title">도착 전에 내는 입국 카드</string>
    <string name="prepare_forms_body">여행을 만들면 어떤 서류가 필요한지 알려 드리고, 앱이 대신 채워 드려요.</string>
    <string name="prepare_items_title">꼭 챙길 물건</string>
    <string name="prepare_items_body">여행지와 계절에 맞춰 챙길 물건을 골라 드려요.</string>
    <string name="prepare_apps_title">미리 설치할 앱</string>
    <string name="prepare_apps_body">차 부르기·길 찾기 앱은 한국에서 미리 설치하고 가입해 두면 편해요.</string>
    <string name="prepare_bookings_title">예약 서류</string>
    <string name="prepare_bookings_body">항공권과 숙소 예약 확인서를 모아 둬요.</string>
    <string name="prepare_speech">여행 준비. 레디포트는 정부 기관과 제휴하지 않았어요. 입국 카드, 꼭 챙길 물건, 미리 설치할 앱, 예약 서류를 챙겨요.</string>

    <!-- 여행지 -->
    <string name="explore_title">여행지</string>
    <string name="explore_subtitle">가고 싶은 곳을 찾고 찜해요</string>
    <string name="explore_popular_title">요즘 인기 여행지</string>
    <string name="explore_popular_body">한국에서 출발하는 비행기 이용객과 검색 흐름으로 매주 순위를 바꿔요.</string>
    <string name="explore_saved_title">찜한 여행지</string>
    <string name="explore_saved_body">찜한 곳의 안내는 와이파이에서 미리 받아 두어서, 인터넷이 없어도 볼 수 있어요.</string>
    <string name="explore_speech">여행지. 요즘 인기 여행지와 찜한 여행지를 볼 수 있어요.</string>

    <!-- 지갑 -->
    <string name="wallet_title">지갑</string>
    <string name="wallet_subtitle">내 서류를 안전하게 모아 둬요</string>
    <string name="wallet_privacy">모든 서류는 이 기기 안에만 암호화해서 저장해요. 레디포트 서버로 보내지 않아요.</string>
    <string name="wallet_passport_title">여권</string>
    <string name="wallet_passport_body">여권 사진을 찍으면 필요한 값만 읽고, 사진은 바로 지워요.</string>
    <string name="wallet_profile_title">내 여행 정보</string>
    <string name="wallet_companions_title">같이 가는 사람</string>
    <string name="wallet_documents_title">받은 서류 (QR·확인서)</string>
    <string name="wallet_speech">지갑. 모든 서류는 이 기기 안에만 암호화해서 저장해요. 여권, 내 여행 정보, 같이 가는 사람, 받은 서류를 모아 둬요.</string>

    <!-- 도움 -->
    <string name="help_title">도움</string>
    <string name="help_offline_badge">인터넷 없어도 돼요</string>
    <string name="help_phrases_title">자주 쓰는 말</string>
    <string name="help_phrases_body">\"화장실이 어디예요?\" 같은 말을 현지어로 크게 보여 주고 소리로 들려 드려요.</string>
    <string name="help_emergency_title">급할 때 연락</string>
    <string name="help_emergency_body">여행지를 고르면 그 나라 긴급 전화, 대한민국 대사관, 여권을 잃어버렸을 때 할 일을 순서대로 알려 드려요.</string>
    <string name="help_speech">도움. 인터넷이 없어도 돼요. 자주 쓰는 말과 급할 때 연락처를 볼 수 있어요.</string>

    <!-- 설정 -->
    <string name="settings_title">설정</string>
    <string name="settings_easy_mode">쉬운 모드</string>
    <string name="settings_easy_mode_desc">글자와 버튼을 크게, 한 화면에 할 일 하나씩</string>
    <string name="settings_family_mode">가족 모드</string>
    <string name="settings_offline_packs">저장한 여행 안내 관리</string>
    <string name="settings_notifications">알림</string>
    <string name="settings_privacy">개인정보 안내</string>
    <string name="settings_privacy_body">여권과 예약 서류는 이 기기 안에서만 읽고 저장해요. 공식 사이트에 입력하는 것도 내가 \'맞아요\'를 누를 때만 해요.</string>
    <string name="settings_disclaimer">출처와 알림</string>
    <string name="settings_disclaimer_body">레디포트는 정부 기관과 제휴하지 않았어요. 모든 안내에 공식 출처와 최종 확인일을 붙여요. 입국 서류의 내용은 신청하는 본인이 책임져요.</string>
    <string name="settings_report">오류 알리기</string>
    <string name="settings_about">앱 정보</string>
    <string name="settings_speech">설정. 쉬운 모드를 켜고 끌 수 있어요.</string>
</resources>
