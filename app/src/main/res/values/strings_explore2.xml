<?xml version="1.0" encoding="utf-8"?>
<!--
  둘러보기·여행 과정 다듬기 (운영자 2026-10-03 — DESIGN_SPEC 부록 H.7).

  운영자 지적(그대로):
    "어디로 떠나세요에서 '입국 카드 … 눌러요'라는 문구가 첫화면에 있어서 뜬금 없는 의미를 전달하고 있어. …
     그리고 내 여행이 1개 이상일 경우, 여행을 흰색 박스로 각 여행을 구분해 주고, 여행 국가는 좀 더 선명하게 표시하고,
     둥근 박스 형태로 1, 2,.. 로 번호를 매겨줘. 그리고 내 여행에서 계획, 예약, 등을 클릭하면 하단으로 이동한 뒤
     상단으로 바로 이동할 수 있는 방법이 없어. 따라서 각 단계를 클릭하면 접혔다가 펴지는 형태로 해줘. …
     그리고 각 단계에 번호가 붙으면 좋겠어."
-->
<resources>
    <!--
      히어로 한 줄 소개. **운영자가 적어 준 문장 그대로**라서 앱의 다른 글(해요체)과 달리 합니다체다 —
      일부러 둔 예외이니 다음 다듬기에서 해요체로 '고치지' 말 것 (EXPLORE_FIX_REPORT 1절).
    -->
    <string name="explore_hero_tagline">레디포트는 당신의 여행이 수월해지도록 돕습니다.</string>

    <!-- 히어로 여행 박스의 둥근 번호(몇 번째 여행인지) — 보이는 글은 숫자뿐, TalkBack은 `여행 1`로 읽는다 -->
    <string name="explore_trip_number_cd">여행 %1$d</string>

    <!-- 박스로 보여 준 여행보다 많을 때 (내 여행 목록으로) -->
    <string name="explore_trips_all">여행 %1$d개 모두 보기</string>

    <!-- 여행 과정 단계 이름을 번호와 함께 읽는 말 (`2단계 예약`) — 화면에는 번호 배지 + 이름으로 보인다 -->
    <string name="journey_stage_step_cd">%1$d단계 %2$s</string>

    <!-- 지금 할 일 카드의 버튼: 그 단계를 그 자리에서 펼친다 -->
    <string name="journey_open_stage_step">%1$d단계 %2$s 열기</string>

    <!-- 둘러보기 여행 박스: 같은 달이면 끝 날짜에서 달을 뺀다(예: 10월 8일 (목) ~ 14일 (수)) — 한 줄에 들어가게 -->
    <string name="home_trip_date_format_day" translatable="false">d일 (E)</string>
</resources>
