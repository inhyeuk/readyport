<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 여권 촬영할 때만 요청한다. 사진 고르기는 Photo Picker라 저장소 권한이 필요 없다 (PRD 7.4) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 입국 카드 제출 가능일·도착 알림 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 필요한 패키지만 선언한다. QUERY_ALL_PACKAGES 사용 금지 (PRD 7.4) -->
    <queries>
        <!-- 이동하기: 국가 팩에 있는 교통·지도 앱만 (PRD 7.4, 9.7) -->
        <package android:name="com.dena.automotive.taxibell" />
        <package android:name="com.gojek.app" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.grabtaxi.passenger" />
        <package android:name="com.ubercab" />
        <package android:name="ee.mtakso.client" />
        <package android:name="jp.sride.userapp" />
        <!-- Play 스토어로 보내기 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- 기기 내장 음성 안내(TextToSpeech) 엔진 찾기 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 개인정보는 기기 밖으로 나가지 않는다: 클라우드 백업·기기 간 이전 모두 제외 (PRD 7.3) -->
    <application
        android:name=".ReadyPortApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReadyPort"
        tools:targetApi="36">

        <!-- Analytics를 넣지 않았지만, 다른 Firebase 모듈이 끌어오더라도 수집·광고 ID를 끈다 (PRD 7.4) -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <!-- WorkManager는 Hilt 워커 팩토리로 직접 초기화한다 (ReadyPortApp.workManagerConfiguration) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- 도착 감지: 위치 권한 없이 시간대 변경으로 (PRD 4.2) -->
        <receiver
            android:name=".trip.TimezoneReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 홈 화면 '입국 QR 열기' 위젯 (PRD 5.4) -->
        <receiver
            android:name=".widget.EntryQrWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_entry_qr_info" />
        </receiver>

        <!-- 다른 폰으로 입국 QR 보내기(시스템 공유)용 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ReadyPort">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 항공사·숙소 앱이나 메일에서 '공유하기'로 예약 서류 받기 (PRD 7.2) -->
            <intent-filter android:label="@string/booking_title">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
