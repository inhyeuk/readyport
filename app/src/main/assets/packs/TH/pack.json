{"schema_version":1,"country":"TH","version":"2026.09.28-2","last_verified":"2026-09-28","names":{"ko":"태국","en":"Thailand","local":"ประเทศไทย"},"local_language":{"name_ko":"태국어","tts_lang":"th-TH"},"sources":[{"id":"mofa_th","name":"외교부 해외안전여행 · 태국","url":"https://0404.go.kr/ntnSafetyInfo/260/detail"},{"id":"embassy_th","name":"주태국 대한민국 대사관","url":"https://overseas.mofa.go.kr/th-ko/index.do"},{"id":"embassy_th_visa","name":"주태국 대한민국 대사관 · 사증 안내","url":"https://overseas.mofa.go.kr/th-ko/brd/m_22304/view.do?seq=728"},{"id":"tdac","name":"태국 이민국 TDAC","url":"https://tdac.immigration.go.th/"},{"id":"passport_kr","name":"외교부 여권안내 · 여권 분실","url":"https://www.passport.go.kr/home/kor/contents.do?menuPos=26"},{"id":"grab_locations","name":"Grab 서비스 국가","url":"https://www.grab.com/sg/locations/"},{"id":"bolt_cities","name":"Bolt 서비스 도시","url":"https://bolt.eu/en/cities/"},{"id":"gmaps_play","name":"Google Play · Google 지도","url":"https://play.google.com/store/apps/details?id=com.google.android.apps.maps"}],"requirements":[{"nationality":"KR","purpose":"tourism","visa":"not_required","stay_limit_days":90,"forms":["TH_TDAC"],"summary_ko":"대한민국 일반 여권은 관광 목적이면 비자 없이 90일까지 머물 수 있어요(두 나라 협정). 도착 전에 태국 입국 카드(TDAC)를 내야 해요.","source":"mofa_th","last_verified":"2026-09-28"}],"forms":[{"id":"TH_TDAC","name_ko":"태국 입국 카드 (TDAC)","name_en":"Thailand Digital Arrival Card","official_url":"https://tdac.immigration.go.th/","fee_ko":"무료","window_ko":"태국에 도착하는 날을 포함해 3일 안에 내요. 예: 5월 4일 도착이면 5월 2일~4일","window_days_including_arrival":3,"source":"mofa_th","last_verified":"2026-09-28"}],"sections":[{"id":"entry","title_ko":"들어갈 때","body_ko":["비자 없이 90일까지 머물 수 있어요(관광·친척 방문 등).","도착 3일 전부터 도착하는 날까지 태국 입국 카드(TDAC)를 공식 사이트에서 무료로 내요. 모든 외국인이 내야 해요.","내고 나서 받은 확인 메일을 입국 심사 때 보여 주세요.","비자 없이 나갔다 들어오기를 자주 되풀이하거나 여권이 훼손돼 있으면 입국이 거절될 수 있어요."],"source":"mofa_th","last_verified":"2026-09-28"},{"id":"payment","title_ko":"돈","body_ko":["돈 단위는 밧(Baht)이에요. 1밧은 100사땅이에요.","지폐는 20·50·100·500·1,000밧 다섯 가지예요.","미화 1만 5천 달러어치가 넘는 현금을 가지고 들어가면 세관(가방 속 물건을 확인하는 곳)에 신고해야 해요.","큰돈과 카드는 되도록 숙소 금고에 두세요."],"source":"mofa_th","last_verified":"2026-09-28"},{"id":"safety","title_ko":"안전 (외교부 여행경보)","body_ko":["대부분 지역은 1단계(여행유의)예요.","딱(Tak) 주는 2단계(여행자제)예요.","말레이시아와 맞닿은 남부 송클라 일부, 빠따니·나라티왓·얄라 주, 캄보디아 국경 50km 안쪽은 3단계(출국권고)예요. 가지 마세요.","여행경보는 자주 바뀌어요. 떠나기 전에 외교부 해외안전여행에서 꼭 다시 확인하세요."],"source":"mofa_th","last_verified":"2026-09-28"}],"transport_apps":[{"name":"Grab","package":"com.grabtaxi.passenger","link_type":"open_and_copy","source":"grab_locations"},{"name":"Bolt","package":"ee.mtakso.client","link_type":"open_and_copy","source":"bolt_cities"},{"name":"Google 지도","package":"com.google.android.apps.maps","link_type":"maps_url","source":"gmaps_play"}],"phrases":[{"id":"restroom","ko":"화장실이 어디예요?","en":"Where is the restroom?","local":"ห้องน้ำอยู่ที่ไหน","romanized":"hong nam yu thi nai","reviewed":false},{"id":"lost","ko":"길을 잃었어요","en":"I'm lost.","local":"ฉันหลงทาง","romanized":"chan long thang","reviewed":false},{"id":"hospital","ko":"병원에 가야 해요","en":"I need to go to a hospital.","local":"ฉันต้องไปโรงพยาบาล","romanized":"chan tong pai rong phayaban","reviewed":false},{"id":"slowly","ko":"천천히 말해 주세요","en":"Please speak slowly.","local":"กรุณาพูดช้าๆ","romanized":"karuna phut cha cha","reviewed":false},{"id":"address","ko":"이 주소로 가 주세요","en":"Please take me to this address.","local":"กรุณาพาไปที่อยู่นี้","romanized":"karuna pha pai thi yu ni","reviewed":false},{"id":"police","ko":"경찰을 불러 주세요","en":"Please call the police.","local":"กรุณาเรียกตำรวจ","romanized":"karuna riak tamruat","reviewed":false},{"id":"help","ko":"도와주세요","en":"Help me, please.","local":"ช่วยด้วย","romanized":"chuai duai","reviewed":false}],"emergency":[{"id":"tourist_police","label_ko":"관광경찰 (영어·한국어, 무료)","number":"1155","source":"mofa_th","last_verified":"2026-09-28"},{"id":"police","label_ko":"경찰 (사건·사고 신고)","number":"191","source":"mofa_th","last_verified":"2026-09-28"},{"id":"medical","label_ko":"응급 환자","number":"1669","source":"mofa_th","last_verified":"2026-09-28"},{"id":"ambulance","label_ko":"구급차 (경찰병원)","number":"1691","source":"mofa_th","last_verified":"2026-09-28"},{"id":"fire","label_ko":"불이 났을 때","number":"199","source":"mofa_th","last_verified":"2026-09-28"}],"embassy":{"name_ko":"주태국 대한민국 대사관 (방콕)","address":"23 Thiam-Ruammit Road, Ratchadapisek, Huai-Khwang, Bangkok 10310, Thailand","phone":"+66-2-481-6000","emergency_phone":"+66-81-914-5803","source":"embassy_th","last_verified":"2026-09-28"},"procedures":[{"id":"passport_lost","title_ko":"여권을 잃어버렸어요","steps_ko":["잃어버린 곳을 맡은 경찰서에 신고하고, 신고 접수증을 받아요.","대한민국 대사관 영사과에 직접 가서 긴급여권을 신청해요. 수수료 1,700밧(현금), 여권 사진, 비행기 표를 챙겨요.","대사관이 주는 태국 이민국용 공문을 받아요.","태국 이민국에서 입국 기록을 확인받은 뒤, 경찰 접수증과 대사관 공문을 가지고 공항으로 가요. 이민국은 주말·공휴일에 쉬어요.","긴급여권은 한 번만 쓸 수 있고 유효기간은 1년이에요. 한국에 돌아와 새 여권을 만들어요."],"source":"mofa_th","last_verified":"2026-09-28"}],"essentials_rules":[],"shopping":[]}