{"schema_version":1,"country":"ID","version":"2026.10.02-1","last_verified":"2026-09-30","names":{"ko":"인도네시아","en":"Indonesia","local":"Indonesia"},"local_language":{"name_ko":"인도네시아어","tts_lang":"id-ID"},"sources":[{"id":"mofa_id","name":"외교부 해외안전여행 · 인도네시아","url":"https://0404.go.kr/ntnSafetyInfo/181/detail"},{"id":"imigrasi_voa","name":"인도네시아 이민국 · 도착비자","url":"https://www.imigrasi.go.id/berita/2024/04/19/jangan-salah-pilih-ini-beda-visa-kunjungan-wisata-dan-visa-on-arrival"},{"id":"imigrasi_aid","name":"인도네시아 이민국 · All Indonesia","url":"https://www.imigrasi.go.id/siaran_pers/penumpang-yang-tiba-di-tiga-bandara-internasional-dan-pelabuhan-di-batam-wajib-deklarasi-kedatangan-melalui-aplikasi-all-indones"},{"id":"beacukai","name":"인도네시아 세관(Bea Cukai) 수카르노하타","url":"https://soetta.beacukai.go.id/mandatory/barang-penumpang.html"},{"id":"embassy_id_lost","name":"주인도네시아 대한민국 대사관 · 여권 분실","url":"https://overseas.mofa.go.kr/id-ko/brd/m_2853/view.do?seq=1346782"},{"id":"grab_locations","name":"Grab 서비스 국가","url":"https://www.grab.com/sg/locations/"},{"id":"gojek_site","name":"Gojek","url":"https://www.gojek.com/en-id"},{"id":"gmaps_play","name":"Google Play · Google 지도","url":"https://play.google.com/store/apps/details?id=com.google.android.apps.maps"},{"id":"wi_power","name":"인도네시아관광부 (전기)","url":"https://www.indonesia.travel/us/en/general-information/plugs-electricity"},{"id":"wi_yogya","name":"인도네시아관광부 · 족자카르타 기념품","url":"https://www.indonesia.travel/sg/en/travel-ideas/culture/6-must-have-signature-souvenirs-from-yogyakarta"},{"id":"wi_bali","name":"인도네시아관광부 · 발리 기념품","url":"https://www.indonesia.travel/ru/en/travel-ideas/culture/searching-for-bali-souvenirs-check-out-these-5-places"},{"id":"customs_allowance","name":"관세청 여행자 휴대품 면세 범위","url":"https://customs.go.kr/kcs/cm/cntnts/cntntsView.do?mi=2837&cntntsId=829"},{"id":"apqa_plant_exempt","name":"농림축산검역본부 검역 제외 식물","url":"https://www.apqa.go.kr/plant/imQua/plant_notest_ex.jsp"},{"id":"embassy_id_evoa","name":"주인도네시아 대한민국 대사관 · 입국 사전신고·전자비자 안내(2026-09-21)","url":"https://overseas.mofa.go.kr/id-bali-ko/brd/m_27049/down.do?brd_id=100931&seq=246&data_tp=A&file_seq=1"},{"id":"imigrasi_evoa_list","name":"인도네시아 이민국 · e-VOA 대상국","url":"https://www.imigrasi.go.id/faq/visa/negara-mana-saja-yang-terdaftar-dalam-daftar-electronic-visa-on-arrival-e-voa"},{"id":"evisa_faq","name":"인도네시아 이민국 e-Visa · 자주 묻는 질문","url":"https://evisa.imigrasi.go.id/front/faqs/university"}],"requirements":[{"nationality":"KR","purpose":"tourism","visa":"on_arrival","stay_limit_days":30,"forms":["ID_ALL_INDONESIA"],"summary_ko":"대한민국 일반 여권은 비자 없이 들어갈 수 없어요. 도착비자(VOA, 30일, IDR 500,000)를 받아야 하고, 미리 온라인(e-VOA)으로도 신청할 수 있어요. 여권이 6개월 넘게 남아 있고 돌아가는 표가 있어야 해요. 도착 전에 All Indonesia도 내요.","source":"mofa_id","last_verified":"2026-09-28","apply":{"form":"ID_ALL_INDONESIA","name_ko":"인도네시아 전자 도착비자 (e-VOA)","official_url":"https://allindonesia.imigrasi.go.id/","fee_ko":"IDR 500,000 · 카드(Mastercard·Visa·JCB)로 직접 결제, 환불은 안 돼요","steps_ko":["앱이 All Indonesia 입국 신고 칸을 채워 드려요. 확인한 뒤 신고는 직접 제출하세요. 마지막에 그림 글자를 직접 입력해요.","제출 뒤 요약 화면에 'Apply for Visa On Arrival (VOA)' 버튼이 보이면 직접 누르세요.","이메일 주소를 확인하고, 결제 화면에서 카드로 직접 결제해요. 결제 화면은 휴대폰 브라우저로 열릴 수 있어요.","결제가 끝나면 'Download e-VOA'로 비자를 받아 두세요. 발급 뒤 90일 안에 들어가야 하고, 들어간 날부터 30일 머물 수 있어요."],"warning_ko":"주소가 go.id로 끝나지 않는 비슷한 사이트는 대행사라 약 95달러 넘게 받아요. 레디포트는 공식 사이트(imigrasi.go.id)만 열어요.","source":"embassy_id_evoa","last_verified":"2026-09-30"},"passport_validity":{"months":6,"basis":"arrival","source":"mofa_id","last_verified":"2026-10-02"}}],"forms":[{"id":"ID_ALL_INDONESIA","name_ko":"인도네시아 입국 신고 (All Indonesia)","name_en":"All Indonesia","official_url":"https://allindonesia.imigrasi.go.id/","fee_ko":"무료","window_ko":"도착 3일 전부터 낼 수 있어요. 입국·세관·검역을 한 번에 신고해요.","source":"imigrasi_aid","last_verified":"2026-09-28"}],"sections":[{"id":"entry","title_ko":"들어갈 때","body_ko":["비자 없이 들어갈 수 없어요. 도착비자(VOA)는 30일이고 한 번 30일 늘릴 수 있어요. 요금은 IDR 500,000이에요.","도착비자는 미리 공식 사이트(evisa.imigrasi.go.id)에서 온라인으로도 받을 수 있어요.","도착 3일 전부터 All Indonesia에 입국·세관·건강 신고를 한 번에 무료로 내요. 이 공항들(수카르노하타·주안다·응우라라이·바탐)은 따로 전자세관신고(e-CD)를 안 해도 돼요.","IDR 1억 루피아가 넘는 현금은 세관에 신고해야 해요."],"source":"imigrasi_aid","last_verified":"2026-09-28"},{"id":"safety","title_ko":"안전 (외교부 여행경보)","body_ko":["대부분 지역은 1단계(여행유의)예요.","서파푸아·파푸아·말루쿠·아체는 2단계(여행자제)예요.","여행경보는 자주 바뀌어요. 떠나기 전에 외교부 해외안전여행에서 다시 확인하세요."],"source":"mofa_id","last_verified":"2026-09-28"}],"transport_apps":[{"name":"Grab","package":"com.grabtaxi.passenger","link_type":"open_and_copy","source":"grab_locations"},{"name":"Gojek","package":"com.gojek.app","link_type":"open_and_copy","source":"gojek_site"},{"name":"Google 지도","package":"com.google.android.apps.maps","link_type":"maps_url","source":"gmaps_play"}],"phrases":[{"id":"restroom","ko":"화장실이 어디예요?","en":"Where is the restroom?","local":"Di mana toilet?","reviewed":false},{"id":"lost","ko":"길을 잃었어요","en":"I'm lost.","local":"Saya tersesat.","reviewed":false},{"id":"hospital","ko":"병원에 가야 해요","en":"I need to go to a hospital.","local":"Saya harus ke rumah sakit.","reviewed":false},{"id":"slowly","ko":"천천히 말해 주세요","en":"Please speak slowly.","local":"Tolong bicara pelan-pelan.","reviewed":false},{"id":"address","ko":"이 주소로 가 주세요","en":"Please take me to this address.","local":"Tolong antar saya ke alamat ini.","reviewed":false},{"id":"police","ko":"경찰을 불러 주세요","en":"Please call the police.","local":"Tolong panggil polisi.","reviewed":false},{"id":"help","ko":"도와주세요","en":"Help me, please.","local":"Tolong!","reviewed":false}],"emergency":[{"id":"police","label_ko":"경찰","number":"110","source":"mofa_id","last_verified":"2026-09-28"},{"id":"fire","label_ko":"불이 났을 때","number":"113","source":"mofa_id","last_verified":"2026-09-28"},{"id":"ambulance","label_ko":"구급차","number":"118","source":"mofa_id","last_verified":"2026-09-28"},{"id":"ambulance2","label_ko":"구급차 (다른 번호)","number":"119","source":"mofa_id","last_verified":"2026-09-28"}],"embassy":{"name_ko":"주인도네시아 대한민국 대사관 (자카르타)","address":"Jalan Jenderal Gatot Subroto Kav. 57 Jakarta 12950, Indonesia","phone":"+62-21-2967-2555","emergency_phone":"+62-811-852-446","source":"mofa_id","last_verified":"2026-09-28"},"procedures":[{"id":"passport_lost","title_ko":"여권을 잃어버렸어요","steps_ko":["경찰서에서 분실 신고 접수증을 받아요.","대한민국 대사관 영사과에서 분실 신고와 긴급여권(Rp 850,000) 또는 여행증명서(Rp 425,000)를 신청해요. 사진 2장을 챙겨요. 요금은 환율에 따라 바뀔 수 있어요.","도착비자로 들어왔으면 새 여권과 대사관 공문을 가지고 이민국 창구에 가야 나갈 수 있어요."],"source":"embassy_id_lost","last_verified":"2026-09-28"}],"shopping":[{"id":"batik","category":"souvenir","names":{"ko":"바틱","en":"Batik","local":"Batik"},"why_ko":"관광부가 족자카르타 대표 기념품으로 소개해요.","import_status":"allowed","import_note_ko":"면세 한도(미화 800달러) 안이면 세금 없이 가져올 수 있어요.","source":"wi_yogya","import_source":"customs_allowance","last_verified":"2026-09-29"},{"id":"silver","category":"souvenir","names":{"ko":"은 장신구","en":"Silver jewellery","local":"Perhiasan perak"},"why_ko":"귀걸이·목걸이·브로치 같은 은 공예품이에요. 관광부 안내에 나와요.","import_status":"allowed","import_note_ko":"면세 한도(미화 800달러) 안이면 세금 없이 가져올 수 있어요.","source":"wi_yogya","import_source":"customs_allowance","last_verified":"2026-09-29"},{"id":"leather","category":"daily","names":{"ko":"가죽 제품","en":"Leather goods","local":"Barang kulit"},"why_ko":"가방·신발·벨트 같은 가죽 제품이에요. 관광부 안내에 나와요.","import_status":"allowed","import_note_ko":"면세 한도(미화 800달러) 안이면 세금 없이 가져올 수 있어요.","source":"wi_yogya","import_source":"customs_allowance","last_verified":"2026-09-29"},{"id":"coffee","category":"food","names":{"ko":"원두 커피","en":"Roasted coffee","local":"Kopi"},"why_ko":"관광부가 발리 기념품으로 소개해요.","import_status":"allowed","import_note_ko":"볶아서 포장된 원두는 식물 검역 대상이 아니에요. 생두는 검역 신고가 필요해요.","source":"wi_bali","import_source":"apqa_plant_exempt","last_verified":"2026-09-29"}],"power":{"plug_ko":"둥근 핀 2개(C·F형)","kr_plug_fits":true,"voltage":"230 V","frequency":"50 Hz","source":"wi_power","last_verified":"2026-09-29"},"checklist":[{"id":"cash_declare","phase":"three_days","icon":"cash","title_ko":"현금 신고 기준 알아 두기","section":"entry","text_ko":"IDR 1억 루피아가 넘는 현금은 세관에 신고해야 해요."}]}