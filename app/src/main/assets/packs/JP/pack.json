{"schema_version":1,"country":"JP","version":"2026.10.03-1","last_verified":"2026-09-28","names":{"ko":"일본","en":"Japan","local":"日本"},"local_language":{"name_ko":"일본어","tts_lang":"ja-JP"},"sources":[{"id":"mofa_jp","name":"외교부 해외안전여행 · 일본","url":"https://0404.go.kr/ntnSafetyInfo/183/detail"},{"id":"vjw","name":"일본 디지털청 · Visit Japan Web","url":"https://services.digital.go.jp/en/visit-japan-web/"},{"id":"customs_jp","name":"일본 세관 · 휴대품 신고","url":"https://www.customs.go.jp/english/passenger/declaration/declaration_app.html"},{"id":"jnto","name":"일본정부관광국(JNTO) · 긴급 상황","url":"https://www.japan.travel/ko/plan/emergencies/"},{"id":"embassy_jp","name":"주일본 대한민국 대사관","url":"https://overseas.mofa.go.kr/jp-ko/"},{"id":"embassy_jp_lost","name":"주일본 대한민국 대사관 · 여권 분실","url":"https://overseas.mofa.go.kr/jp-ko/brd/m_1087/view.do?seq=1344011"},{"id":"go_site","name":"GO (GO Inc.)","url":"https://go.goinc.jp/"},{"id":"sride_play","name":"Google Play · S.RIDE","url":"https://play.google.com/store/apps/details?id=jp.sride.userapp"},{"id":"uber_cities","name":"Uber 서비스 도시","url":"https://www.uber.com/global/en/cities/"},{"id":"gmaps_play","name":"Google Play · Google 지도","url":"https://play.google.com/store/apps/details?id=com.google.android.apps.maps"},{"id":"jnto_power","name":"일본정부관광국 (전기)","url":"https://www.japan.travel/en/plan/plug-and-electricity/"},{"id":"jnto_souvenirs","name":"일본정부관광국 · 기념품","url":"https://www.japan.travel/en/guide/last-minute-souvenirs/"},{"id":"customs_allowance","name":"관세청 여행자 휴대품 면세 범위","url":"https://customs.go.kr/kcs/cm/cntnts/cntntsView.do?mi=2837&cntntsId=829"},{"id":"apqa_plant_exempt","name":"농림축산검역본부 검역 제외 식물","url":"https://www.apqa.go.kr/plant/imQua/plant_notest_ex.jsp"},{"id":"apqa_livestock","name":"농림축산검역본부 휴대 축산물 검역","url":"https://www.apqa.go.kr/livestock/qua/livestock_imp_sum2.jsp?type=1"},{"id":"naa_inter_arr","name":"나리타 국제공항(NAA) · 도착 안내: 국제선","url":"https://www.narita-airport.jp/ko/airportguide/inter-arr/"},{"id":"hnd_arr_step","name":"하네다 공항 여객 터미널 · 도착 수속(국제선)","url":"https://tokyo-haneda.com/ko/flight/int/arr_step.html"},{"id":"kix_arr","name":"간사이 국제공항 · 도착 절차(제1터미널)","url":"https://www.kansai-airport.or.jp/kr/flight/route/t1_arr"},{"id":"kix_arr_t2","name":"간사이 국제공항 · 도착 절차(제2터미널)","url":"https://www.kansai-airport.or.jp/kr/flight/route/t2_arr"},{"id":"fuk_flow_int","name":"후쿠오카 국제공항(주) · 비행기 탑승법(국제선) 도착 절차","url":"https://www.fukuoka-airport.jp/ko/flight/flow_int/index.html"},{"id":"isa_kiosk","name":"일본 출입국재류관리청 · 공동 키오스크 운용 안내","url":"https://www.moj.go.jp/isa/06_00024.html"},{"id":"vjw_guide","name":"일본 디지털청 · Visit Japan Web 이용 안내","url":"https://services.digital.go.jp/ko/visit-japan-web/guide/"},{"id":"customs_jp_egate","name":"일본 세관 · 전자 신고 게이트(7개 공항)","url":"https://www.customs.go.jp/english/passenger/egate.htm"}],"requirements":[{"nationality":"KR","purpose":"tourism","visa":"not_required","stay_limit_days":90,"forms":["JP_VJW"],"summary_ko":"대한민국 일반 여권은 비자 없이 90일까지 머물 수 있어요. Visit Japan Web으로 입국·세관 신고를 미리 할 수 있어요(꼭 해야 하는 건 아니고, 종이 신고서도 돼요).","source":"mofa_jp","last_verified":"2026-09-28","passport_validity":null}],"forms":[{"id":"JP_VJW","name_ko":"일본 입국·세관 신고 (Visit Japan Web)","name_en":"Visit Japan Web","official_url":"https://www.vjw.digital.go.jp/","fee_ko":"무료. 돈을 받는 사이트와 'Visit Japan Web' 이름의 앱은 가짜예요(공식 앱 없음).","window_ko":"계정을 만들고 떠나기 전에 미리 적어 두면, 도착해서 휴대폰으로 QR을 보여 줘요.","source":"vjw","last_verified":"2026-09-28"}],"sections":[{"id":"entry","title_ko":"들어갈 때","body_ko":["비자 없이 90일까지 머물 수 있어요(돈을 버는 일은 안 돼요).","Visit Japan Web에 입국·세관 신고를 미리 하면 도착해서 QR을 보여 주면 돼요. 공식 앱은 없어요.","100만 엔 이상 현금은 들어올 때와 나갈 때 신고해야 해요."],"source":"mofa_jp","last_verified":"2026-09-28"},{"id":"safety","title_ko":"안전 (외교부 여행경보)","body_ko":["후쿠시마 원전 반경 30km 안과 정부 피난 지시 구역만 3단계(출국권고)예요.","도움이 필요하면 일본정부관광국 방문객 전화(050-3816-2787, 24시간, 한국어)도 있어요."],"source":"mofa_jp","last_verified":"2026-09-28"}],"transport_apps":[{"name":"GO","package":"com.dena.automotive.taxibell","link_type":"open_and_copy","source":"go_site"},{"name":"S.RIDE","package":"jp.sride.userapp","link_type":"open_and_copy","source":"sride_play"},{"name":"Uber","package":"com.ubercab","link_type":"uber_url","source":"uber_cities"},{"name":"Google 지도","package":"com.google.android.apps.maps","link_type":"maps_url","source":"gmaps_play"}],"phrases":[{"id":"restroom","ko":"화장실이 어디예요?","en":"Where is the restroom?","local":"トイレはどこですか？","romanized":"toire wa doko desu ka","reviewed":false},{"id":"lost","ko":"길을 잃었어요","en":"I'm lost.","local":"道に迷いました。","romanized":"michi ni mayoimashita","reviewed":false},{"id":"hospital","ko":"병원에 가야 해요","en":"I need to go to a hospital.","local":"病院に行かなければなりません。","romanized":"byouin ni ikanakereba narimasen","reviewed":false},{"id":"slowly","ko":"천천히 말해 주세요","en":"Please speak slowly.","local":"ゆっくり話してください。","romanized":"yukkuri hanashite kudasai","reviewed":false},{"id":"address","ko":"이 주소로 가 주세요","en":"Please take me to this address.","local":"この住所まで行ってください。","romanized":"kono juusho made itte kudasai","reviewed":false},{"id":"police","ko":"경찰을 불러 주세요","en":"Please call the police.","local":"警察を呼んでください。","romanized":"keisatsu wo yonde kudasai","reviewed":false},{"id":"help","ko":"도와주세요","en":"Help me, please.","local":"助けてください！","romanized":"tasukete kudasai","reviewed":false}],"emergency":[{"id":"police","label_ko":"경찰","number":"110","source":"mofa_jp","last_verified":"2026-09-28"},{"id":"fire_ambulance","label_ko":"불·구급차","number":"119","source":"jnto","last_verified":"2026-09-28"},{"id":"sea","label_ko":"바다에서 사고","number":"118","source":"mofa_jp","last_verified":"2026-09-28"},{"id":"jnto_hotline","label_ko":"일본정부관광국 방문객 전화 (24시간, 한국어)","number":"050-3816-2787","source":"jnto","last_verified":"2026-09-28"}],"embassy":{"name_ko":"주일본 대한민국 대사관 (도쿄) — 영사부는 南麻布1-7-32로 따로 있어요","address":"106-0047 東京都港区南麻布1-2-5","phone":"+81-3-3452-7611","emergency_phone":"+81-70-2153-5454","source":"embassy_jp","last_verified":"2026-09-28"},"procedures":[{"id":"passport_lost","title_ko":"여권을 잃어버렸어요","steps_ko":["경찰서나 파출소(交番)에 신고하고 접수증을 받아요. 검문 때 보여 줘야 할 수 있어요.","대사관 영사부(평일 09:00–16:00)에서 긴급여권을 신청해요. 1–2일 걸리고 수수료는 6,500엔(엔화 현금)이에요.","신청서, 분실 신고서, 분실 사유서, 경찰 접수증, 신분증, 사진 1장을 챙겨요. 신고한 여권은 다시 찾아도 쓸 수 없어요."],"source":"embassy_jp_lost","last_verified":"2026-09-28"}],"shopping":[{"id":"boxed_sweets","category":"food","names":{"ko":"선물용 과자 상자","en":"Boxed sweets","local":"お菓子の詰め合わせ"},"why_ko":"과자·센베이·젤리를 담은 선물 상자예요. 관광국 기념품 안내에 나와요.","import_status":"caution","import_note_ko":"고기·달걀 같은 축산물이 들어간 제품은 검역 대상일 수 있어요. 성분을 보고 입국 때 신고하세요.","source":"jnto_souvenirs","import_source":"apqa_livestock","last_verified":"2026-09-29"},{"id":"tea","category":"food","names":{"ko":"차","en":"Tea","local":"お茶"},"why_ko":"관광국이 부담 없는 선물로 소개해요.","import_status":"allowed","import_note_ko":"소매용으로 밀봉된 차만 검역 대상이 아니에요.","source":"jnto_souvenirs","import_source":"apqa_plant_exempt","last_verified":"2026-09-29"},{"id":"umeboshi","category":"food","names":{"ko":"우메보시(매실 절임)","en":"Umeboshi","local":"梅干し"},"why_ko":"관광국 기념품 안내에 나와요.","import_status":"allowed","import_note_ko":"소금·설탕에 절여 포장된 식물 가공품은 식물 검역 대상이 아니에요.","source":"jnto_souvenirs","import_source":"apqa_plant_exempt","last_verified":"2026-09-29"},{"id":"stationery","category":"daily","names":{"ko":"문구·작은 피규어","en":"Stationery and small figurines","local":"文房具"},"why_ko":"관광국 기념품 안내에 나와요.","import_status":"allowed","import_note_ko":"면세 한도(미화 800달러) 안이면 세금 없이 가져올 수 있어요.","source":"jnto_souvenirs","import_source":"customs_allowance","last_verified":"2026-09-29"},{"id":"lacquerware","category":"souvenir","names":{"ko":"칠기","en":"Lacquerware","local":"漆器"},"why_ko":"관광국이 일본 전통 기념품으로 소개해요.","import_status":"allowed","import_note_ko":"면세 한도(미화 800달러) 안이면 세금 없이 가져올 수 있어요.","source":"jnto_souvenirs","import_source":"customs_allowance","last_verified":"2026-09-29"}],"power":{"plug_ko":"출처에 플러그 모양 설명 없음","kr_plug_fits":null,"voltage":"100 V","frequency":"50 Hz(동일본)·60 Hz(서일본)","source":"jnto_power","last_verified":"2026-09-29"},"airports":[{"code":"NRT","name_ko":"나리타 국제공항","name_en":"Narita International Airport","city_ko":"도쿄","egate_kr":null,"egate_note_ko":null,"form_check_ko":"Visit Japan Web(VJW) QR은 입국 심사 카운터에서 보여 줘요. 세관에서는 전자 신고 단말기나 검사대에서 보여 줘요.","steps":[{"kind":"health","title_ko":"검역","body_ko":"안내를 따라 검역 카운터로 가요. 기내에서 받은 검역 질문지를 써서 내요. 설사나 열이 있으면 검역관에게 알려요.","where_ko":null},{"kind":"form_check","title_ko":"공동 키오스크 (VJW 등록자)","body_ko":"VJW QR과 여권을 키오스크에 읽혀요. 여권 정보, 얼굴 사진, 지문, 신고 정보를 한 번에 내요. 끝나면 키오스크 이용자 전용 심사 부스로 가요.","where_ko":"제1·2터미널: 입국 동선 구역과 입국 심사장 안 / 제3터미널: 입국 동선 구역","source":"isa_kiosk"},{"kind":"immigration","title_ko":"입국 심사","body_ko":"입국 심사 카운터에 여권을 내요.","where_ko":null},{"kind":"baggage","title_ko":"짐 찾기","body_ko":"안내 보드에서 항공사와 편명을 확인하고 수하물 수취대로 가요. 짐표(수하물 확인증)로 내 짐이 맞는지 확인해요. 과일·채소·햄 같은 걸 가져왔다면 동식물 검역 카운터에서 검사를 받아요.","where_ko":null},{"kind":"customs","title_ko":"세관 (가방 속 물건 확인)","body_ko":"모든 승객은 휴대품·별송품 신고서를 내요. 면세 범위 안이면 초록색 검사대, 넘거나 잘 모르면 빨간색 검사대로 가요. 전자 신고를 했다면 전자 신고 게이트로 멈추지 않고 지나갈 수 있어요.","where_ko":null},{"kind":"exit","title_ko":"도착 로비로 나가요","body_ko":"세관을 마치면 안내를 따라 도착 로비로 가요.","where_ko":null}],"map_url":"https://www.narita-airport.jp/ko/airportguide/inter-arr/","source":"naa_inter_arr","last_verified":"2026-10-03","form_check_source":"vjw_guide"},{"code":"HND","name_ko":"하네다 공항","name_en":"Tokyo International Airport (Haneda)","city_ko":"도쿄","egate_kr":null,"egate_note_ko":null,"form_check_ko":"Visit Japan Web(VJW) QR은 입국 심사 카운터에서 보여 줘요. 세관에서는 전자 신고 단말기나 검사대에서 보여 줘요.","steps":[{"kind":"health","title_ko":"검역","body_ko":"해외에서 몸이 안 좋아졌다면 검역 수속을 해요. 기내에서 건강 질문표를 받았다면 써서 검역 카운터에 내요.","where_ko":null},{"kind":"form_check","title_ko":"공동 키오스크 (VJW 등록자)","body_ko":"VJW QR과 여권을 키오스크에 읽혀요. 여권 정보, 얼굴 사진, 지문, 신고 정보를 한 번에 내요. 끝나면 키오스크 이용자 전용 심사 부스로 가요.","where_ko":"제2·제3터미널 입국 동선 구역과 입국 심사장 안","source":"isa_kiosk"},{"kind":"immigration","title_ko":"입국 심사","body_ko":"여권을 준비하고 안내에 따라 외국인 줄로 가요. VJW를 쓰지 않았다면 입국 카드도 준비해요. 여권 커버는 빼서 내요.","where_ko":null},{"kind":"baggage","title_ko":"짐 찾기","body_ko":"근처 안내판에서 항공사와 편명을 보면 수취대 번호를 알 수 있어요. 고기·과일·동물·식물을 가져왔다면 짐을 찾은 뒤 검사를 받아요.","where_ko":null},{"kind":"customs","title_ko":"세관 (가방 속 물건 확인)","body_ko":"짐을 든 채로 세관 검사 구역으로 가요. 휴대품 신고서를 내고 검사를 받아요. 짐을 기다리는 동안 전자 신고 단말기로 세관 신고를 할 수도 있어요.","where_ko":null,"source":"vjw_guide"},{"kind":"exit","title_ko":"도착 로비로 나가요","body_ko":"안내 표시를 보고 원하는 교통편으로 가요.","where_ko":null}],"map_url":"https://tokyo-haneda.com/ko/flight/int/arr_step.html","source":"hnd_arr_step","last_verified":"2026-10-03","form_check_source":"vjw_guide"},{"code":"KIX","name_ko":"간사이 국제공항","name_en":"Kansai International Airport","city_ko":"오사카","egate_kr":null,"egate_note_ko":null,"form_check_ko":"Visit Japan Web(VJW) QR은 입국 심사 카운터에서 보여 줘요. 세관에서는 전자 신고 단말기나 검사대에서 보여 줘요.","steps":[{"kind":"deplane","title_ko":"비행기에서 내려요","body_ko":"비행기에서 터미널로 바로 걸어가거나, 셔틀로 이동하는 경우가 있어요.","where_ko":null},{"kind":"health","title_ko":"검역","body_ko":"비행기에서 내린 뒤 검역과 입국 수속을 밟아요.","where_ko":null},{"kind":"form_check","title_ko":"공동 키오스크 (VJW 등록자)","body_ko":"VJW QR과 여권을 키오스크에 스캔해요. 외국 국적인 사람은 키오스크가 정해 준 길로 가요.","where_ko":"제1터미널: 입국 심사장, 도착 셔틀 각 역 / 제2터미널: 입국 심사장 안","source":"isa_kiosk"},{"kind":"immigration","title_ko":"입국 심사","body_ko":"키오스크를 쓰지 않았다면 입국 심사관이 있는 심사 부스로 가요.","where_ko":null},{"kind":"baggage","title_ko":"짐 찾기","body_ko":"수하물 인도장 안내판에서 항공사와 편명을 확인하고 짐을 찾아요. 채소·과일·고기 등을 가져왔다면 검사를 받아요.","where_ko":null},{"kind":"customs","title_ko":"세관 (가방 속 물건 확인)","body_ko":"VJW 이용자는 키오스크가 정해준 길(전자 신고 게이트, 유인 세관 부스)로 가요. 종이 신고서는 세관 검사 통로에서 내요. 세관 직원이 질문하거나 짐을 검사할 수 있어요.","where_ko":null},{"kind":"exit","title_ko":"도착 출구로 나가요","body_ko":"세관을 지나 도착 출구로 나가요.","where_ko":null}],"map_url":"https://www.kansai-airport.or.jp/kr/flight/route/t1_arr","source":"kix_arr","last_verified":"2026-10-03","form_check_source":"vjw_guide"},{"code":"FUK","name_ko":"후쿠오카 공항","name_en":"Fukuoka Airport","city_ko":"후쿠오카","egate_kr":null,"egate_note_ko":null,"form_check_ko":"Visit Japan Web(VJW) QR은 입국 심사 카운터에서 보여 줘요. 세관에서는 전자 신고 단말기나 검사대에서 보여 줘요.","steps":[{"kind":"deplane","title_ko":"비행기에서 내려요","body_ko":"국제선 터미널 2층 도착 중앙홀로 들어와요. 도착 후에는 검역 → 입국 심사 순서로 가요.","where_ko":"국제선 2층 도착 중앙홀"},{"kind":"health","title_ko":"검역","body_ko":"여행 중 설사나 열이 있어 몸이 안 좋으면 건강상담실로 가요.","where_ko":null},{"kind":"form_check","title_ko":"공동 키오스크 (VJW 등록자)","body_ko":"VJW QR과 여권을 키오스크에 읽혀요. 여권 정보, 얼굴 사진, 지문, 신고 정보를 한 번에 내요. 끝나면 키오스크 이용자 전용 심사 부스로 가요. 후쿠오카 공항은 2025년 12월 1일부터 쓸 수 있고, 7:00~21:00에 열어요.","where_ko":null,"source":"isa_kiosk"},{"kind":"immigration","title_ko":"입국 심사","body_ko":"일본인·외국인 표시를 보고 외국인 카운터로 가요. 여권을 내고 심사를 받아요.","where_ko":"국제선 2층 입국 검사장"},{"kind":"baggage","title_ko":"짐 찾기","body_ko":"전광판에서 항공사와 편명을 보고 수취대에서 짐을 찾아요. 수하물 교환증 번호와 맞춰봐요. 고기·과일·식물 등은 검역 카운터에 신고해요.","where_ko":"국제선 1층 수하물 찾는 곳"},{"kind":"customs","title_ko":"세관 (가방 속 물건 확인)","body_ko":"일본에 들어오는 모든 사람은 휴대품·별송품 신고서를 내요. 면세 범위를 넘으면 세금을 내요. 짐을 기다리는 동안 전자 신고 단말기로 세관 신고를 할 수도 있어요.","where_ko":"국제선 1층 세관검사장","source":"vjw_guide"},{"kind":"exit","title_ko":"도착 로비로 나가요","body_ko":"1층 도착 로비로 나가요. 마중 나온 사람과 만나기 좋은 곳이에요.","where_ko":"국제선 1층 도착 로비"}],"map_url":"https://www.fukuoka-airport.jp/ko/flight/flow_int/index.html","source":"fuk_flow_int","last_verified":"2026-10-03","form_check_source":"vjw_guide"}],"checklist":[{"id":"cash_declare","phase":"three_days","icon":"cash","title_ko":"현금 신고 기준 알아 두기","section":"entry","text_ko":"100만 엔 이상 현금은 들어올 때와 나갈 때 신고해야 해요."}]}