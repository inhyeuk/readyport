ot_required","stay_limit_days":90,"forms":["SG_SGAC"],"summary_ko":"대한민국 일반 여권은 비자 없이 90일까지 머물 수 있어요(두 나라 협정). 도착 전에 싱가포르 입국 카드(SGAC)를 내야 해요.","source":"mofa_sg","last_verified":"2026-09-28","passport_validity":{"months":6,"basis":"arrival","source":"ica_entering","last_verified":"2026-10-02"}}],"forms":[{"id":"SG_SGAC","name_ko":"싱가포르 입국 카드 (SGAC)","name_en":"SG Arrival Card","official_url":"https://eservices.ica.gov.sg/sgarrivalcard/","fee_ko":"무료. 돈을 받는 대행 사이트는 ICA와 관계없어요.","window_ko":"도착하는 날을 포함해 3일 안에 내요.","window_days_including_arrival":3,"source":"ica_sgac","last_verified":"2026-09-28"}],"sections":[{"id":"entry","title_ko":"들어갈 때","body_ko":["비자 없이 90일까지 머물 수 있어요.","도착하는 날을 포함해 3일 안에 공식 사이트나 MyICA 앱으로 입국 카드(SGAC)를 무료로 내요.","싱가포르 달러 2만 달러 이상 현금은 들어올 때와 나갈 때 신고해야 해요.","담배는 가지고 들어갈 수 없고, 전자담배는 금지예요(벌금·추방)."],"source":"mofa_sg","last_verified":"2026-09-28"},{"id":"payment","title_ko":"돈","body_ko":["돈 단위는 싱가포르 달러(SGD)예요."],"source":"mofa_sg","last_verified":"2026-09-28"},{"id":"safety","title_ko":"안전 (외교부 여행경보)","body_ko":["지금 싱가포르에 내려진 여행경보는 없어요. 떠나기 전에 외교부 해외안전여행에서 다시 확인하세요."],"source":"mofa_sg","last_verified":"2026-09-28"}],"transport_apps":[{"name":"Grab","package":"com.grabtaxi.passenger","link_type":"open_and_copy","source":"grab_locations"},{"name":"Gojek","package":"com.gojek.app","link_type":"open_and_copy","source":"gojek_site"},{"name":"Google 지도","package":"com.google.android.apps.maps","link_type":"maps_url","source":"gmaps_play"}],"phrases":[{"id":"restroom","ko":"화장실이 어디예요?","en":"Where is the restroom?","local":"Where is the restroom?","reviewed":true},{"id":"lost","ko":"길을 잃었어요","en":"I'm lost.","local":"I'm lost.","reviewed":true},{"id":"hospital","ko":"병원에 가야 해요","en":"I need to go to a hospital.","local":"I need to go to a hospital.","reviewed":true},{"id":"slowly","ko":"천천히 말해 주세요","en":"Please speak slowly.","local":"Please speak slowly.","reviewed":true},{"id":"address","ko":"이 주소로 가 주세요","en":"Please take me to this address.","local":"Please take me to this address.","reviewed":true},{"id":"police","ko":"경찰을 불러 주세요","en":"Please call the police.","local":"Please call the police.","reviewed":true},{"id":"help","ko":"도와주세요","en":"Help me, please.","local":"Help me, please.","reviewed":true}],"emergency":[{"id":"police","label_ko":"경찰","number":"999","source":"mofa_sg","last_verified":"2026-09-28"},{"id":"ambulance_fire","label_ko":"구급차·불","number":"995","source":"mofa_sg","last_verified":"2026-09-28"}],"embassy":{"name_ko":"주싱가포르 대한민국 대사관 (영사과 16층)","address":"47 Scotts Road #08-00 Goldbell Towers Singapore 228233","phone":"+65-6256-1188","emergency_phone":"+65-9654-3528","source":"mofa_sg","last_verified":"2026-09-28"},"procedures":[{"id":"passport_lost","title_ko":"여권을 잃어버렸어요","steps_ko":["싱가포르 경찰에 분실 신고를 해요. 받은 분실 신고서는 나갈 때 출국 심사관에게 내요.","대한민국 대사관(평일 09:00–12:30, 14:00–17:00)에서 긴급여권을 신청해요. 보통 오전에 내면 오후에 받아요.","신청서, 분실 신고서, 분실 사유서, 사진 1장, 신분증, 돌아가는 전자 항공권을 챙겨요."],"source":"embassy_sg_lost","last_verified":"2026-09-28"}],"shopping":[{"id":"kaya","category":"food","names":{"ko":"카야 잼","en":"Kaya jam","local":"Kaya"},"why_ko":"코코넛으로 만든 잼이에요. 관광청 현지 브랜드 안내에 나와요.","import_status":"caution","import_note_ko":"달걀 등 축산물이 들어간 가공식품이에요. 입국할 때 검역 신고하고 안내를 따르세요.","source":"stb_local_brands","import_source":"apqa_livestock","last_verified":"2026-09-29"},{"id":"salted_egg_snack","category":"food","names":{"ko":"솔티드 에그 과자","en":"Salted egg snacks","local":"Salted egg snack"},"why_ko":"관광청이 싱가포르 대표 과자로 소개해요.","import_status":"caution","import_note_ko":"달걀 등 축산물이 들어간 가공식품이에요. 입국할 때 검역 신고하고 안내를 따르세요.","source":"stb_local_brands","import_source":"apqa_livestock","last_verified":"2026-09-29"},{"id":"tea_coffee_set","category":"food","names":{"ko":"차·커피 선물 세트","en":"Tea and coffee gift sets","local":"Tea and coffee gift set"},"why_ko":"관광청 현지 브랜드 안내에 선물용으로 나와요.","import_status":"allowed","import_note_ko":"소매용으로 밀봉된 차만 검역 대상이 아니에요.","source":"stb_local_brands","import_source":"apqa_plant_exempt","last_verified":"2026-09-29"},{"id":"peranakan_accessories","category":"souvenir","names":{"ko":"페라나칸 장신구","en":"Peranakan-style accessories","local":"Peranakan accessories"},"why_ko":"페라나칸 전통을 살린 장신구예요. 관광청 안내에 나와요.","import_status":"allowed","import_note_ko":"면세 한도(미화 800달러) 안이면 세금 없이 가져올 수 있어요.","source":"stb_local_brands","import_source":"customs_allowance","last_verified":"2026-09-29"},{"id":"bakkwa","category":"food","names":{"ko":"박과(돼지고기 육포)","en":"Bakkwa","local":"Bak kwa"},"why_ko":"관광청이 소개하는 명물이지만 고기 제품이라 한국에 가져올 수 없어요.","import_status":"prohibited","import_note_ko":"육포 등 축산물은 검역본부가 가져오지 말라고 안내해요. 진공 포장이어도 마찬가지예요.","source":"stb_local_brands","import_source":"apqa_livestock","last_verified":"2026-09-29"}],"power":{"plug_ko":"납작한 핀 3개(13A, 영국식)","kr_plug_fits":false,"voltage":"230 V","frequency":"50 Hz","source":"sp_group","last_verified":"2026-09-29"},"checklist":[{"id":"no_tobacco","phase":"week","icon":"rules","title_ko":"담배·전자담배는 두고 가기","section":"entry","text_ko":"담배는 가지고 들어갈 수 없고, 전자담배는 금지예요(벌금·추방)."},{"id":"cash_declare","phase":"three_days","icon":"cash","title_ko":"현금 신고 기준 알아 두기","section":"entry","text_ko":"싱가포르 달러 2만 달러 이상 현금은 들어올 때와 나갈 때 신고해야 해요."}]}