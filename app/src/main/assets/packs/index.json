{"schema_version":1,"version":"2026.10.03-2","countries":[{"code":"TH","name_ko":"태국","name_en":"Thailand","pack":true},{"code":"JP","name_ko":"일본","name_en":"Japan","pack":true},{"code":"SG","name_ko":"싱가포르","name_en":"Singapore","pack":true},{"code":"MY","name_ko":"말레이시아","name_en":"Malaysia","pack":true},{"code":"ID","name_ko":"인도네시아","name_en":"Indonesia","pack":true},{"code":"TW","name_ko":"대만","name_en":"Taiwan","pack":true},{"code":"CN","name_ko":"중국","name_en":"China","pack":true},{"code":"PH","name_ko":"필리핀","name_en":"Philippines","pack":true},{"code":"VN","name_ko":"베트남","name_en":"Vietnam","pack":true}],"common_emergency":[{"id":"consular_call_center","label_ko":"영사콜센터 (서울, 24시간)","number":"+82-2-3210-0404","note_ko":"해외에서 걸 때 번호예요. 통화료가 들어요.","source":"mofa_0404","last_verified":"2026-09-28"}],"sources":[{"id":"mofa_0404","name":"외교부 해외안전여행","url":"https://0404.go.kr"},{"id":"visitkorea_power","name":"한국관광공사 VisitKorea (전기)","url":"https://english.visitkorea.or.kr/svc/contents/contentsView.do?vcontsId=140041"},{"id":"molit_powerbank_2026","name":"국토교통부 보조배터리 기내 반입 기준 (2026.4.8 발표)","url":"https://www.korea.kr/news/policyNewsView.do?newsId=148962298"},{"id":"e_insmarket","name":"보험다모아 (손해보험협회·생명보험협회)","url":"https://www.e-insmarket.or.kr/"},{"id":"customs_allowance","name":"관세청 여행자 휴대품 면세 범위","url":"https://customs.go.kr/kcs/cm/cntnts/cntntsView.do?mi=2837&cntntsId=829"},{"id":"apqa_plant","name":"농림축산검역본부 휴대 식물 검역","url":"https://www.apqa.go.kr/plant/imQua/plant_quar_wong_ex.jsp"},{"id":"apqa_livestock","name":"농림축산검역본부 휴대 축산물 검역","url":"https://www.apqa.go.kr/livestock/qua/livestock_imp_sum2.jsp?type=1"},{"id":"passport_reissue","name":"외교부 여권안내 · 여권 재발급","url":"https://www.passport.go.kr/home/kor/contents.do?menuPos=7"}],"home_power":{"plug_ko":"둥근 구멍 2개 콘센트","kr_plug_fits":true,"voltage":"220 V","frequency":"60 Hz","source":"visitkorea_power","last_verified":"2026-09-29"},"essentials":[{"id":"passport","name_ko":"여권","condition":"always","reason_ko":"출국과 입국에 꼭 필요해요. 남은 유효기간 기준은 나라마다 달라요 — 여행지 안내에서 확인하세요."},{"id":"power_bank","name_ko":"보조배터리","condition":"always","rule_badge":"carry_on_only","reason_ko":"지도·번역을 많이 써서 배터리가 빨리 닳아요. 부치는 짐에 넣을 수 없고, 1인당 2개(160Wh 이하)까지 들고 탈 수 있어요. 기내에서는 충전·사용할 수 없어요. 단자는 절연테이프나 지퍼백으로 감싸세요.","source":"molit_powerbank_2026","last_verified":"2026-09-29"},{"id":"plug_adapter","name_ko":"변환 어댑터","condition":"plug_differs","reason_ko":"한국 플러그가 그대로 맞지 않거나, 맞는지 공식 확인이 안 된 나라예요. 여러 나라용 어댑터를 챙기면 편해요."},{"id":"voltage_check","name_ko":"충전기 전압 확인","condition":"voltage_differs","reason_ko":"여행지 전압이 한국(220V)과 많이 달라요. 충전기·기기에 '100-240V' 표시가 있는지 확인하세요. 없으면 변압기가 필요해요."},{"id":"travel_insurance","name_ko":"여행자 보험","condition":"always","reason_ko":"현지에서 아프거나 다치면 병원비를 직접 내야 할 수 있어요. 보험사 상품을 공식 비교 사이트에서 직접 비교해 보세요. 레디포트는 보험 수수료를 받지 않아요.","link":{"type":"official_info","url":"https://www.e-insmarket.or.kr/","label_ko":"공식 비교 사이트 열기"},"source":"e_insmarket","last_verified":"2026-09-29"},{"id":"payment","name_ko":"결제 수단 두 가지","condition":"always","reason_ko":"카드가 안 될 때를 대비해 결제 수단을 두 가지 이상 준비하세요. 나라별 결제 방법은 여행지 안내에 있어요."},{"id":"medicine","name_ko":"평소 먹는 약·상비약","condition":"always","reason_ko":"현지에서 같은 약을 찾기 어려울 수 있어요. 평소 먹는 약은 넉넉히 챙기세요."}],"return_links":[{"id":"customs","label_ko":"관세청 · 여행자 면세 범위","url":"https://customs.go.kr/kcs/cm/cntnts/cntntsView.do?mi=2837&cntntsId=829"},{"id":"apqa_plant","label_ko":"검역본부 · 과일·식물 반입","url":"https://www.apqa.go.kr/plant/imQua/plant_quar_wong_ex.jsp"},{"id":"apqa_livestock","label_ko":"검역본부 · 고기·축산물 반입","url":"https://www.apqa.go.kr/livestock/qua/livestock_imp_sum2.jsp?type=1"}],"return_facts":[{"text_ko":"기본 면세 한도는 미화 800달러(과세가격 합계)예요. 넘으면 자진 신고하세요 — 관세의 30%를 줄여 줘요.","source":"customs_allowance","last_verified":"2026-09-29"},{"text_ko":"별도 면세: 술 2L 이하·미화 400달러 이하, 담배 200개비, 향수 100ml. 만 19세 미만은 술·담배 면세가 없어요.","source":"customs_allowance","last_verified":"2026-09-29"},{"text_ko":"망고·파파야·오렌지·포도 같은 생과일은 대부분 들여올 수 없어요. 모든 식물은 입국 때 검역 신고를 해야 해요.","source":"apqa_plant","last_verified":"2026-09-29"},{"text_ko":"고기·햄·소시지·육포 같은 축산물은 가져오지 마세요. 신고하지 않고 걸리면 최고 1,000만 원 과태료예요.","source":"apqa_livestock","last_verified":"2026-09-29"}],"checklist":[{"id":"passport_validity","phase":"month","stage":"plan","icon":"passport","kind":"auto","title_ko":"여권 남은 기간 확인하기","from":"passport_validity","action":"open_passport"},{"id":"visa","phase":"month","stage":"plan","icon":"visa","kind":"pack","title_ko":"비자·머무는 기간 확인하기","from":"visa"},{"id":"booking","phase":"month","stage":"book","icon":"flight","kind":"generic","title_ko":"항공권·숙소 예약 다시 보기","body_ko":"예약한 영문 이름이 여권과 같은지, 날짜와 공항이 맞는지 한 번 더 확인하세요."},{"id":"essential.travel_insurance","phase":"month","stage":"book","icon":"insurance","kind":"essential","from":"essential:travel_insurance"},{"id":"advisory","phase":"month","stage":"plan","icon":"advisory","kind":"pack","title_ko":"여행경보 다시 확인하기","body_ko":"여행경보는 자주 바뀌어요. 떠나기 전에 외교부 해외안전여행에서 가는 곳의 단계를 다시 보세요.","from":"advisory"},{"id":"passport_saved","phase":"month","stage":"docs","icon":"wallet","kind":"auto","title_ko":"여권 정보 앱에 넣어 두기","body_ko":"입국 카드 칸을 앱이 채울 때 써요. 이 휴대폰 안에만 암호화해서 둬요.","from":"passport_saved","action":"open_passport"},{"id":"data","phase":"month","stage":"book","icon":"data","kind":"generic","title_ko":"데이터 준비하기(로밍·eSIM·유심)","body_ko":"현지에서 지도와 번역을 쓰려면 데이터가 필요해요. 통신사 로밍, eSIM, 현지 유심 가운데 하나를 골라 미리 준비하세요."},{"id":"essential.payment","phase":"week","stage":"pack","icon":"card","kind":"essential","title_ko":"해외 결제 카드·현금 두 가지 준비하기","from":"essential:payment"},{"id":"essential.medicine","phase":"week","stage":"pack","icon":"medicine","kind":"essential","from":"essential:medicine"},{"id":"essential.power_bank","phase":"week","stage":"pack","icon":"battery","kind":"essential","from":"essential:power_bank"},{"id":"essential.plug_adapter","phase":"week","stage":"pack","icon":"plug","kind":"essential","from":"essential:plug_adapter"},{"id":"essential.voltage_check","phase":"week","stage":"pack","icon":"voltage","kind":"essential","from":"essential:voltage_check"},{"id":"offline_pack","phase":"week","stage":"pack","icon":"offline","kind":"auto","title_ko":"인터넷 없이 볼 나라 안내 받아 두기","body_ko":"이 나라 안내가 휴대폰에 있으면 인터넷이 없어도 입국·도움 화면을 볼 수 있어요.","from":"offline_pack"},{"id":"offline_map","phase":"week","stage":"pack","icon":"map","kind":"generic","title_ko":"오프라인 지도 저장하기","body_ko":"지도 앱에서 머무는 동네를 미리 저장해 두면 데이터가 없어도 길을 찾을 수 있어요."},{"id":"address_local","phase":"week","stage":"pack","icon":"address","kind":"generic","title_ko":"숙소 주소를 현지어로 저장하기","body_ko":"택시 기사님께 보여 줄 수 있게 숙소 주소를 현지어 그대로 앱에 넣어 두세요.","action":"open_transport"},{"id":"consular_call","phase":"week","stage":"pack","icon":"phone","kind":"pack","title_ko":"영사콜센터 번호 저장하기","from":"consular","action":"open_help"},{"id":"entry_form","phase":"three_days","stage":"docs","icon":"form","kind":"auto","title_ko":"입국 카드 내기","from":"entry_form","action":"open_form"},{"id":"phrases","phase":"three_days","stage":"pack","icon":"phrases","kind":"generic","title_ko":"현지어 카드 미리 보기","body_ko":"화장실·병원·길을 잃었을 때 보여 줄 문장을 미리 한 번 봐 두세요.","action":"open_help"},{"id":"essential.passport","phase":"departure_day","stage":"departure","icon":"passport","kind":"essential","title_ko":"여권·입국 확인 화면 챙기기","body_ko":"여권은 몸에 지니고, 입국 카드 QR이나 확인 메일은 '입국 때 보여 주기'에서 바로 열 수 있게 해 두세요.","from":"essential:passport","action":"open_present"},{"id":"airport_time","phase":"departure_day","stage":"departure","icon":"airport","kind":"generic","title_ko":"공항에 넉넉히 일찍 가기","body_ko":"국제선은 짐 부치기와 보안 검색에 시간이 걸려요. 항공사가 안내한 시간보다 늦지 않게 가세요."},{"id":"airport_steps","phase":"arrival","stage":"arrival","icon":"airport","kind":"pack","title_ko":"도착 공항 순서 보기","body_ko":"입국 심사·짐 찾기·세관을 어떤 순서로 지나는지, 입국 카드는 어디서 보여 주는지 공항별로 볼 수 있어요.","from":"airports","action":"open_airport"},{"id":"show_entry","phase":"arrival","stage":"arrival","icon":"qr","kind":"generic","title_ko":"입국 심사에서 확인 화면 보여 주기","body_ko":"입국 카드를 냈으면 받은 QR이나 확인 메일을 바로 꺼낼 수 있게 해 두세요.","action":"open_present","when":"has_form"},{"id":"emergency_number","phase":"arrival","stage":"arrival","icon":"emergency","kind":"pack","title_ko":"현지 긴급 번호 알아 두기","from":"emergency","action":"open_help"},{"id":"passport_keep","phase":"during","stage":"during","icon":"safe","kind":"generic","title_ko":"여권은 따로 안전하게 두기","body_ko":"여권을 잃어버리면 다시 받는 데 시간이 걸려요. 숙소 금고나 가방 깊은 곳에 두세요."},{"id":"shopping_check","phase":"during","stage":"during","icon":"shopping","kind":"generic","title_ko":"산 물건 한국에 들여올 수 있는지 보기","body_ko":"쇼핑 리스트에 담아 두면 돌아올 때 반입 판정을 다시 보여 줘요.","action":"open_shopping"},{"id":"return_rules","phase":"before_return","stage":"return","icon":"customs","kind":"pack","title_ko":"면세 한도·반입 금지 다시 보기","from":"return_facts"},{"id":"leftover_cash","phase":"before_return","stage":"return","icon":"cash","kind":"generic","title_ko":"남은 현금 정리하기","body_ko":"남은 현지 돈을 공항 가기 전에 쓸지, 가지고 돌아올지 정해 두세요."},{"id":"return_flight","phase":"before_return","stage":"return","icon":"flight_return","kind":"generic","title_ko":"돌아가는 비행기 시간 다시 보기","body_ko":"출발 시간과 공항·터미널을 한 번 더 확인하고, 공항까지 가는 시간을 넉넉히 잡으세요."},{"id":"passport_destroy","phase":"back","stage":"return","icon":"delete","kind":"auto","title_ko":"여권 정보 지우기(고를 수 있어요)","body_ko":"다음 여행 전까지 쓸 일이 없으면 이 휴대폰에서 여권 정보만 지울 수 있어요. 받은 입국 서류 그림은 남아요.","from":"passport_destroyed","action":"destroy_passport"}]}