{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyport-app.web.app/schema/recipe-1.json",
  "title": "ReadyPort autofill recipe (schema_version 1)",
  "description": "공식 사이트 자동 입력 레시피. 선언형 데이터만 — 실행 코드(JavaScript)를 담지 않는다 (PRD 7.5). 엔진은 앱에 내장된다.",
  "type": "object",
  "required": ["schema_version", "form_id", "version", "last_verified", "site_version_seen", "sources", "source", "official_url_patterns", "start_url", "labels_reviewed", "steps", "checkpoints"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "form_id": { "type": "string", "pattern": "^[A-Z]{2}_[A-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-\\d+$" },
    "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "site_version_seen": { "type": "string", "description": "레시피를 확인할 때 사이트가 표시한 버전. 다르면 실패 리포트에 남긴다" },
    "site_version_selector": { "type": "string" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "url"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "url": { "type": "string", "pattern": "^https://" } }
      }
    },
    "source": { "type": "string" },
    "official_url_patterns": {
      "description": "이 주소들에서만 엔진을 실행한다. https만, 끝의 * 는 경로 접두사",
      "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://[a-z0-9.-]+/" }
    },
    "start_url": { "type": "string", "pattern": "^https://" },
    "submitted_url_contains": { "type": "string", "description": "제출 완료 화면 주소에 들어 있는 문자열" },
    "labels_reviewed": { "type": "boolean", "description": "현지어 라벨 원어민 검수 여부" },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title_ko", "fields"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title_ko": { "type": "string" },
          "probe": { "type": ["string", "null"], "description": "이 단계가 화면에 있는지 확인하는 선택자" },
          "note_ko": { "type": "string" },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
        }
      }
    },
    "checkpoints": {
      "description": "사람이 직접 해야 하는 곳. 엔진은 표시만 하고 절대 누르거나 채우지 않는다 (PRD 2.2)",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kind", "ko"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["captcha", "declaration", "health", "final_submit", "email"] },
          "selector": { "type": ["string", "null"] },
          "ko": { "type": "string" }
        }
      }
    },
    "options": {
      "description": "앱에서 고르는 값(예: 여행 목적). 사이트 선택지 글자는 확인 전이면 넣지 않는다",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object", "required": ["value", "ko", "en"], "additionalProperties": false,
          "properties": { "value": { "type": "string" }, "ko": { "type": "string" }, "en": { "type": "string" }, "local": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["key", "widget", "labels", "source", "confirm"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+$" },
        "selector": { "type": ["string", "null"] },
        "widget": {
          "enum": ["text", "assist"],
          "description": "text = 확인된 글자 입력칸이라 앱이 채움. assist = 선택 목록·달력 등 확인 전이라 값만 한글 말풍선으로 보여 주고 사람이 입력"
        },
        "transform": { "enum": ["upper", "none"] },
        "labels": {
          "type": "object", "required": ["ko", "en"], "additionalProperties": false,
          "properties": { "ko": { "type": "string" }, "en": { "type": "string" }, "local": { "type": "string" } }
        },
        "source": { "enum": ["passport", "booking", "profile", "user_choice", "user_input"] },
        "confirm": { "enum": ["bulk", "individual"], "description": "bulk = 서류에서 온 값(묶어서 1번 확인), individual = 고르거나 적는 값" },
        "required": { "type": "boolean" },
        "options_ref": { "type": "string" },
        "hint_ko": { "type": "string" }
      }
    }
  }
}
