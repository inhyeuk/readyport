{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyport-app.web.app/schema/pack-1.json",
  "title": "ReadyPort country pack (schema_version 1)",
  "description": "국가 팩. 정책·연락처 항목은 모두 source(sources[].id)와 last_verified를 가진다 (작업 규칙 6).",
  "type": "object",
  "required": [
    "schema_version",
    "country",
    "version",
    "last_verified",
    "names",
    "sources",
    "requirements",
    "forms",
    "sections",
    "phrases",
    "emergency",
    "procedures"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "last_verified": {
      "$ref": "#/$defs/date"
    },
    "names": {
      "type": "object",
      "required": [
        "ko",
        "en",
        "local"
      ],
      "additionalProperties": false,
      "properties": {
        "ko": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "local": {
          "type": "string"
        }
      }
    },
    "local_language": {
      "type": "object",
      "required": [
        "name_ko",
        "tts_lang"
      ],
      "additionalProperties": false,
      "properties": {
        "name_ko": {
          "type": "string"
        },
        "tts_lang": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nationality",
          "purpose",
          "visa",
          "forms",
          "summary_ko",
          "source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "nationality": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "purpose": {
            "enum": [
              "tourism",
              "business",
              "transit"
            ]
          },
          "visa": {
            "enum": [
              "not_required",
              "required",
              "eta_required",
              "on_arrival"
            ]
          },
          "stay_limit_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "forms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary_ko": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          },
          "apply": {
            "description": "비자를 온라인으로 신청하는 길. 앱은 form 양식의 입력을 돕고, 신청 버튼·결제는 사람이 직접 한다",
            "type": "object",
            "required": [
              "form",
              "name_ko",
              "fee_ko",
              "steps_ko",
              "source",
              "last_verified"
            ],
            "additionalProperties": false,
            "properties": {
              "form": {
                "type": "string",
                "pattern": "^[A-Z]{2}_[A-Z0-9_]+$"
              },
              "name_ko": {
                "type": "string"
              },
              "official_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "fee_ko": {
                "type": "string"
              },
              "steps_ko": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "warning_ko": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "last_verified": {
                "$ref": "#/$defs/date"
              }
            }
          },
          "passport_validity": {
            "description": "여권이 얼마나 남아 있어야 하는지(공식 안내 그대로). 공식 안내가 밝히지 않으면 null — 앱은 '공식 안내에서 확인하세요'만 보인다",
            "type": [
              "object",
              "null"
            ],
            "required": [
              "months",
              "basis",
              "source",
              "last_verified"
            ],
            "additionalProperties": false,
            "properties": {
              "months": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "basis": {
                "description": "arrival = 입국일 기준, departure = 그 나라에서 나가는 날 기준, stay_end = 머무는 기간이 끝나는 날 기준",
                "enum": [
                  "arrival",
                  "departure",
                  "stay_end"
                ]
              },
              "source": {
                "type": "string"
              },
              "last_verified": {
                "$ref": "#/$defs/date"
              }
            }
          }
        }
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name_ko",
          "name_en",
          "official_url",
          "fee_ko",
          "window_ko",
          "source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}_[A-Z0-9_]+$"
          },
          "name_ko": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "official_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "optional": {
            "type": "boolean",
            "description": "의무가 아닌(권장) 신고인지. true 면 앱이 '꼭 내야 하는 건 아니에요'로 보이고, 체크리스트·오늘 단계의 입국 카드 할 일로 세지 않는다"
          },
          "fee_ko": {
            "type": "string"
          },
          "window_ko": {
            "type": "string"
          },
          "window_days_including_arrival": {
            "type": [
              "integer",
              "null"
            ],
            "description": "도착일을 포함해 며칠 전부터 낼 수 있는지 (예: 3 = 도착 2일 전~도착일)"
          },
          "source": {
            "type": "string"
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "sections": {
      "description": "가이드 본문(기본·교통·결제·음식·안전 등). 직접 작성한 글만 (작업 규칙 7)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_ko",
          "body_ko",
          "source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "basic",
              "entry",
              "seasons",
              "transport",
              "payment",
              "food",
              "places",
              "safety",
              "shopping",
              "rules"
            ]
          },
          "title_ko": {
            "type": "string"
          },
          "body_ko": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source": {
            "type": "string"
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "transport_apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "package",
          "link_type",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "package": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
          },
          "link_type": {
            "enum": [
              "maps_url",
              "uber_url",
              "open_and_copy"
            ]
          },
          "source": {
            "type": "string",
            "description": "이 나라에서 서비스한다는 공식 출처(sources[].id)"
          }
        }
      }
    },
    "phrases": {
      "description": "현지어 카드. 원어민 검수 전에는 reviewed=false (ROADMAP 14장)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ko",
          "en",
          "local",
          "reviewed"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "ko": {
            "type": "string"
          },
          "en": {
            "type": "string"
          },
          "local": {
            "type": "string"
          },
          "romanized": {
            "type": "string"
          },
          "reviewed": {
            "type": "boolean"
          }
        }
      }
    },
    "emergency": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_ko",
          "number",
          "source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label_ko": {
            "type": "string"
          },
          "number": {
            "type": "string",
            "pattern": "^\\+?[0-9 ()-]+$"
          },
          "note_ko": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "embassy": {
      "type": "object",
      "required": [
        "name_ko",
        "address",
        "phone",
        "source",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "name_ko": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "description": "공관이 공개한 표기 그대로(번역·음역하지 않는다)"
        },
        "phone": {
          "type": "string"
        },
        "emergency_phone": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "last_verified": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "procedures": {
      "description": "위기 때 할 일 순서 (여권 분실·아플 때)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_ko",
          "steps_ko",
          "source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title_ko": {
            "type": "string"
          },
          "steps_ko": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source": {
            "type": "string"
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "shopping": {
      "description": "쇼핑 리스트 (PRD 11.3). 브랜드명 금지, 반입 가능 여부는 관세청·검역본부 출처(import_source)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "names",
          "why_ko",
          "import_status",
          "source",
          "import_source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "food",
              "daily",
              "souvenir"
            ]
          },
          "names": {
            "$ref": "#/properties/names"
          },
          "where_ko": {
            "type": "string"
          },
          "why_ko": {
            "type": "string"
          },
          "import_status": {
            "enum": [
              "allowed",
              "caution",
              "prohibited"
            ]
          },
          "import_note_ko": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "import_source": {
            "type": "string"
          },
          "last_verified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "power": {
      "type": "object",
      "required": [
        "plug_ko",
        "voltage",
        "frequency",
        "source",
        "last_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "plug_ko": {
          "type": "string"
        },
        "kr_plug_fits": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "voltage": {
          "type": "string"
        },
        "frequency": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "airports": {
      "description": "도착 공항 순서(공항에 도착하면). 공항 운영사·이민국·세관·0404 공식 안내에서 연 문장만, 짧은 해요체로 (작업 규칙 6·7). 없으면 앱은 공항 묶음을 그리지 않는다",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name_ko",
          "name_en",
          "city_ko",
          "egate_kr",
          "form_check_ko",
          "steps",
          "map_url",
          "source",
          "last_verified"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "IATA 공항 코드"
          },
          "name_ko": {
            "type": "string",
            "minLength": 1
          },
          "name_en": {
            "type": "string",
            "minLength": 1
          },
          "city_ko": {
            "type": "string",
            "minLength": 1
          },
          "egate_kr": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "한국 여권으로 자동 출입국 심사대(e-gate)를 쓸 수 있는지. 공식 안내가 한국 여권을 콕 집어 밝힐 때만 true/false, 아니면 null(앱은 줄을 숨긴다)"
          },
          "egate_note_ko": {
            "type": [
              "string",
              "null"
            ]
          },
          "form_check_ko": {
            "type": [
              "string",
              "null"
            ],
            "description": "입국 카드(QR·확인 메일)를 어디서 보여 주는지. 앱은 입국 심사(또는 form_check) 단계에 강조해 보인다"
          },
          "form_check_source": {
            "type": "string",
            "description": "form_check_ko 만 다른 공식 출처일 때(sources[].id). 없으면 공항 source"
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "title_ko",
                "body_ko"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "deplane",
                    "health",
                    "immigration",
                    "egate",
                    "form_check",
                    "baggage",
                    "customs",
                    "transfer",
                    "exit"
                  ]
                },
                "title_ko": {
                  "type": "string",
                  "minLength": 1
                },
                "body_ko": {
                  "type": "string",
                  "minLength": 1
                },
                "where_ko": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "공식 안내에 적힌 위치(층·홀)만. 지도·기억으로 짐작하지 않는다"
                },
                "source": {
                  "type": "string",
                  "description": "이 단계만 다른 공식 출처일 때(sources[].id). 없으면 공항 source"
                }
              }
            }
          },
          "map_url": {
            "type": "string",
            "pattern": "^https://",
            "description": "공식 공항 안내도·도착 안내 페이지"
          },
          "source": {
            "type": "string"
          },
          "last_verified": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "checklist": {
      "description": "이 나라만의 여행 체크리스트 항목. text_ko는 같은 팩 sections[section].body_ko의 한 문장과 글자까지 같아야 한다(출처·확인일은 그 섹션 것 — build_packs.py가 검사)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "icon",
          "title_ko",
          "section",
          "text_ko"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "phase": {
            "enum": [
              "month",
              "week",
              "three_days",
              "departure_day",
              "arrival",
              "during",
              "before_return",
              "back"
            ]
          },
          "icon": {
            "enum": [
              "passport",
              "visa",
              "flight",
              "insurance",
              "advisory",
              "wallet",
              "data",
              "card",
              "medicine",
              "battery",
              "plug",
              "voltage",
              "offline",
              "map",
              "address",
              "phone",
              "form",
              "phrases",
              "airport",
              "qr",
              "emergency",
              "safe",
              "shopping",
              "customs",
              "cash",
              "flight_return",
              "delete",
              "ticket",
              "hotel",
              "rules",
              "family"
            ]
          },
          "title_ko": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "text_ko": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-\\d+$"
    }
  }
}
