{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readyport-app.web.app/schema/index-1.json",
  "title": "ReadyPort pack index (schema_version 1)",
  "description": "지원 국가 목록과 모든 나라에 공통인 연락처(영사콜센터 등).",
  "type": "object",
  "required": ["schema_version", "version", "countries", "common_emergency", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-\\d+$" },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name_ko", "name_en", "pack"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name_ko": { "type": "string" },
          "name_en": { "type": "string" },
          "pack": { "type": "boolean", "description": "국가 팩이 있는지. false면 '안내 준비 중'" }
        }
      }
    },
    "common_emergency": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label_ko", "number", "source", "last_verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label_ko": { "type": "string" },
          "number": { "type": "string", "pattern": "^\\+?[0-9 ()-]+$" },
          "note_ko": { "type": "string" },
          "source": { "type": "string" },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "url"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
