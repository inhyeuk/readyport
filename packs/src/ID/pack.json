  "requirements": [
    {
      "nationality": "KR",
      "purpose": "tourism",
      "visa": "on_arrival",
      "stay_limit_days": 30,
      "forms": [
        "ID_ALL_INDONESIA"
      ],
      "summary_ko": "대한민국 일반 여권은 비자 없이 들어갈 수 없어요. 도착비자(VOA, 30일, IDR 500,000)를 받아야 하고, 미리 온라인(e-VOA)으로도 신청할 수 있어요. 여권이 6개월 넘게 남아 있고 돌아가는 표가 있어야 해요. 도착 전에 All Indonesia도 내요.",
      "source": "mofa_id",
      "last_verified": "2026-09-28",
      "apply": {
        "form": "ID_ALL_INDONESIA",
        "name_ko": "인도네시아 전자 도착비자 (e-VOA)",
        "official_url": "https://allindonesia.imigrasi.go.id/",
        "fee_ko": "IDR 500,000 · 카드(Mastercard·Visa·JCB)로 직접 결제, 환불은 안 돼요",
        "steps_ko": [
          "앱이 All Indonesia 입국 신고 칸을 채워 드려요. 확인한 뒤 신고는 직접 제출하세요. 마지막에 그림 글자를 직접 입력해요.",
          "제출 뒤 요약 화면에 'Apply for Visa On Arrival (VOA)' 버튼이 보이면 직접 누르세요.",
          "이메일 주소를 확인하고, 결제 화면에서 카드로 직접 결제해요. 결제 화면은 휴대폰 브라우저로 열릴 수 있어요.",
          "결제가 끝나면 'Download e-VOA'로 비자를 받아 두세요. 발급 뒤 90일 안에 들어가야 하고, 들어간 날부터 30일 머물 수 있어요."
        ],
        "warning_ko": "주소가 go.id로 끝나지 않는 비슷한 사이트는 대행사라 약 95달러 넘게 받아요. 레디포트는 공식 사이트(imigrasi.go.id)만 열어요.",
        "source": "embassy_id_evoa",
        "last_verified": "2026-09-30"
      },
      "passport_validity": {
        "months": 6,
        "basis": "arrival",
        "source": "mofa_id",
        "last_verified": "2026-10-02"
      }
    }
