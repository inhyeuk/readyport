{
  "schema_version": 1,
  "form_id": "SG_SGAC",
  "version": "2026.09.28-2",
  "last_verified": "2026-09-28",
  "site_version_seen": "Last Updated 25 March 2026",
  "sources": [
    { "id": "sgac_site", "name": "싱가포르 ICA SG Arrival Card(실기기에서 1단계 화면, 나머지는 공개 앱 코드의 입력 칸 이름 확인, 제출하지 않음)", "url": "https://eservices.ica.gov.sg/sgarrivalcard/" }
  ],
  "source": "sgac_site",
  "official_url_patterns": ["https://eservices.ica.gov.sg/sgarrivalcard/*"],
  "start_url": "https://eservices.ica.gov.sg/sgarrivalcard/",
  "labels_reviewed": false,
  "steps": [
    {
      "id": "traveller",
      "title_ko": "여행자 정보",
      "probe": "[formcontrolname=\"fullname\"]",
      "note_ko": "처음 화면에서 'Submit SGAC' → 'Foreign Visitor'를 눌러 주세요.",
      "fields": [
        { "key": "passport.full_name_given_first", "selector": "[formcontrolname=\"fullname\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "이름 (영문, 이름 다음 성)", "en": "Full Name (In Passport)" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.number", "selector": "[formcontrolname=\"tdno\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "여권 번호", "en": "Passport Number" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.expiry_date", "selector": "[formcontrolname=\"tdExpiry\"]", "widget": "text", "transform": "date_dmy",
          "labels": { "ko": "여권 만료일", "en": "Date of Passport Expiry" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.birth_date", "selector": "#indDob_0", "widget": "text", "transform": "date_dmy",
          "labels": { "ko": "생년월일", "en": "Date of Birth" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.nationality", "selector": "[formcontrolname=\"natcd\"]", "widget": "assist",
          "labels": { "ko": "국적", "en": "Nationality/Citizenship" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "목록에서 대한민국을 찾아 골라 주세요" },
        { "key": "profile.country_birth", "selector": "[formcontrolname=\"placeOfBirth\"]", "widget": "assist",
          "labels": { "ko": "태어난 나라", "en": "Country/Place of Birth" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "대한민국", "hint_ko": "목록에서 골라 주세요" },
        { "key": "profile.city_res", "selector": "[formcontrolname=\"placeOfResidence\"]", "widget": "assist",
          "labels": { "ko": "사는 곳", "en": "Place of Residence" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "예: SEOUL — 목록에서 골라 주세요" },
        { "key": "profile.email", "selector": "[formcontrolname=\"emailAddr\"]", "widget": "text",
          "labels": { "ko": "이메일", "en": "Email Address" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "확인 메일을 받을 주소" },
        { "key": "profile.phone_code", "selector": "[formcontrolname=\"countryCode\"]", "widget": "text",
          "labels": { "ko": "전화 나라 번호", "en": "Country/Region Code" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "82" },
        { "key": "profile.phone", "selector": "[formcontrolname=\"mobileNumber\"]", "widget": "text",
          "labels": { "ko": "휴대폰 번호", "en": "Mobile Number" }, "source": "user_input", "confirm": "individual", "required": true }
      ]
    },
    {
      "id": "trip",
      "title_ko": "여행 정보",
      "probe": "[formcontrolname=\"purposeOfTravel\"]",
      "fields": [
        { "key": "trip.arrival_date", "selector": null, "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "도착 날짜", "en": "Date of Arrival" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "날짜 버튼 중에서 골라 주세요" },
        { "key": "trip.purpose", "selector": "[formcontrolname=\"purposeOfTravel\"]", "widget": "assist",
          "labels": { "ko": "여행 목적", "en": "Purpose of Travel" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "purpose", "hint_ko": "목록에서 골라 주세요" },
        { "key": "trip.flight_prefix", "selector": "[formcontrolname=\"carrierCd\"]", "widget": "assist",
          "labels": { "ko": "항공사 코드", "en": "Carrier" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "목록에서 이 항공사 코드를 골라 주세요" },
        { "key": "trip.flight_digits", "selector": "[formcontrolname=\"flightNo\"]", "widget": "text",
          "labels": { "ko": "편명 숫자", "en": "Flight No." }, "source": "booking", "confirm": "bulk", "required": true },
        { "key": "trip.country_board", "selector": "[formcontrolname=\"lastCity\"]", "widget": "assist",
          "labels": { "ko": "마지막으로 출발한 도시", "en": "Last city before Singapore" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "예: INCHEON — 목록에서 골라 주세요" },
        { "key": "trip.departure_date", "selector": "[formcontrolname=\"dod\"]", "widget": "text", "transform": "date_dmy",
          "labels": { "ko": "떠나는 날짜", "en": "Date of Departure" }, "source": "booking", "confirm": "bulk", "required": false }
      ]
    },
    {
      "id": "stay",
      "title_ko": "숙소",
      "probe": "[formcontrolname=\"postalCode\"]",
      "fields": [
        { "key": "stay.hotel", "selector": "[formcontrolname=\"hotelCd\"]", "widget": "assist",
          "labels": { "ko": "호텔 이름", "en": "Hotel" }, "source": "booking", "confirm": "bulk", "required": false,
          "hint_ko": "숙소 종류 버튼을 누른 뒤 목록에서 골라 주세요" },
        { "key": "stay.post_code", "selector": "[formcontrolname=\"postalCode\"]", "widget": "text",
          "labels": { "ko": "숙소 우편번호 (6자리)", "en": "Postal Code" }, "source": "user_input", "confirm": "individual", "required": false },
        { "key": "stay.address", "selector": "[formcontrolname=\"streetName\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "숙소 길 이름 (영문)", "en": "Street Name" }, "source": "booking", "confirm": "bulk", "required": false }
      ]
    }
  ],
  "checkpoints": [
    { "id": "captcha", "kind": "captcha", "selector": "[formcontrolname=\"captchaAns\"]", "ko": "보안 문자는 직접 적어 주세요" },
    { "id": "health", "kind": "health", "selector": "[formcontrolname=\"staticQn2\"]", "ko": "건강 질문은 직접 답해 주세요" },
    { "id": "final_submit", "kind": "final_submit", "selector": "button[type=\"submit\"]", "ko": "마지막 'Submit'은 직접 눌러 주세요" }
  ],
  "options": {
    "purpose": [
      { "value": "tourism", "ko": "관광", "en": "Tourism" },
      { "value": "business", "ko": "출장", "en": "Business" }
    ]
  }
}
