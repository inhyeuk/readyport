{
  "schema_version": 1,
  "form_id": "TH_TDAC",
  "version": "2026.09.28-2",
  "last_verified": "2026-09-28",
  "site_version_seen": "2026.09.00-0543",
  "sources": [
    { "id": "tdac_site", "name": "태국 이민국 TDAC 공식 사이트(실기기에서 입력 화면 구조와 선택지 확인, 제출하지 않음)", "url": "https://tdac.immigration.go.th/arrival-card/" }
  ],
  "source": "tdac_site",
  "official_url_patterns": ["https://tdac.immigration.go.th/arrival-card/*"],
  "start_url": "https://tdac.immigration.go.th/arrival-card/",
  "submitted_url_contains": "/arrival-card/add/submitted",
  "labels_reviewed": false,
  "steps": [
    {
      "id": "personal",
      "title_ko": "개인 정보",
      "probe": "[formcontrolname=\"familyName\"]",
      "fields": [
        { "key": "passport.surname", "selector": "[formcontrolname=\"familyName\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "성 (영문)", "en": "Family Name", "local": "นามสกุล" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.given", "selector": "[formcontrolname=\"firstName\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "이름 (영문)", "en": "First Name", "local": "ชื่อ" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.number", "selector": "[formcontrolname=\"passportNo\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "여권 번호", "en": "Passport No." }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.nationality", "selector": null, "widget": "assist",
          "labels": { "ko": "국적", "en": "Nationality/Citizenship" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "칸에 KOREA를 적고 목록에서 대한민국을 골라 주세요" },
        { "key": "passport.birth_date", "selector": null, "widget": "assist",
          "labels": { "ko": "생년월일", "en": "Date of Birth" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "yyyy · mm · dd 칸을 차례로 골라 주세요" },
        { "key": "passport.gender", "selector": "[formcontrolname=\"gender\"]", "widget": "assist",
          "labels": { "ko": "성별", "en": "Gender" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "profile.occupation", "selector": "[formcontrolname=\"occupation\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "직업 (영문)", "en": "Occupation" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "예: OFFICE WORKER, STUDENT, RETIRED" },
        { "key": "profile.country_res", "selector": null, "widget": "assist",
          "labels": { "ko": "사는 나라", "en": "Country/Territory of Residence" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "대한민국", "hint_ko": "칸에 KOREA를 적고 목록에서 대한민국을 골라 주세요" },
        { "key": "profile.city_res", "selector": null, "widget": "assist",
          "labels": { "ko": "사는 도시 (영문)", "en": "City/State of Residence" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "예: SEOUL — 적은 뒤 목록에서 골라 주세요" },
        { "key": "profile.phone_code", "selector": "[formcontrolname=\"phoneCode\"]", "widget": "text",
          "labels": { "ko": "전화 나라 번호", "en": "Phone code" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "82", "hint_ko": "대한민국은 82 (+는 사이트에 이미 있어요)" },
        { "key": "profile.phone", "selector": "[formcontrolname=\"phoneNo\"]", "widget": "text",
          "labels": { "ko": "휴대폰 번호", "en": "Phone No." }, "source": "user_input", "confirm": "individual", "required": true }
      ]
    },
    {
      "id": "trip",
      "title_ko": "여행·숙소 정보",
      "probe": "[formcontrolname=\"arrDate\"]",
      "fields": [
        { "key": "trip.arrival_date", "selector": "[formcontrolname=\"arrDate\"]", "widget": "text", "transform": "date_slash",
          "labels": { "ko": "도착 날짜", "en": "Date of Arrival", "local": "วันที่เดินทางมาถึง" }, "source": "booking", "confirm": "bulk", "required": true },
        { "key": "trip.country_board", "selector": null, "widget": "assist",
          "labels": { "ko": "비행기를 탄 나라", "en": "Country/Territory where you Boarded" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "대한민국", "hint_ko": "칸에 KOREA를 적고 목록에서 골라 주세요" },
        { "key": "trip.purpose", "selector": "[formcontrolname=\"traPurposeId\"]", "widget": "assist",
          "labels": { "ko": "여행 목적", "en": "Purpose of Travel", "local": "วัตถุประสงค์การเดินทาง" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "purpose" },
        { "key": "trip.arrival_mode", "selector": "[formcontrolname=\"traModeId\"]", "widget": "assist",
          "labels": { "ko": "오는 방법", "en": "Mode of Travel" }, "source": "booking", "confirm": "bulk", "required": true,
          "site_value": "AIR" },
        { "key": "trip.transport_mode", "selector": "[formcontrolname=\"tranModeId\"]", "widget": "assist",
          "labels": { "ko": "탈것 종류", "en": "Mode of Transport" }, "source": "booking", "confirm": "bulk", "required": false,
          "hint_ko": "비행기 종류를 목록에서 골라 주세요" },
        { "key": "trip.flight_no", "selector": "[formcontrolname=\"flightNo\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "도착 편명", "en": "Flight No./Vehicle No." }, "source": "booking", "confirm": "bulk", "required": true },
        { "key": "trip.departure_date", "selector": "[formcontrolname=\"deptDate\"]", "widget": "text", "transform": "date_slash",
          "labels": { "ko": "떠나는 날짜", "en": "Date of Departure" }, "source": "booking", "confirm": "bulk", "required": false },
        { "key": "trip.departure_mode", "selector": "[formcontrolname=\"deptTraModeId\"]", "widget": "assist",
          "labels": { "ko": "떠나는 방법", "en": "Mode of Travel" }, "source": "booking", "confirm": "bulk", "required": false,
          "site_value": "AIR" },
        { "key": "trip.departure_flight_no", "selector": "[formcontrolname=\"deptFlightNo\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "떠나는 편명", "en": "Flight No./Vehicle No." }, "source": "booking", "confirm": "bulk", "required": false },
        { "key": "stay.type", "selector": "[formcontrolname=\"accTypeId\"]", "widget": "assist",
          "labels": { "ko": "숙소 종류", "en": "Type of Accommodation in Thailand" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "stay_type" },
        { "key": "stay.province", "selector": null, "widget": "assist",
          "labels": { "ko": "숙소가 있는 주", "en": "Province" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "예: BANGKOK — 적은 뒤 목록에서 골라 주세요" },
        { "key": "stay.district", "selector": null, "widget": "assist",
          "labels": { "ko": "구·지역", "en": "District, Area" }, "source": "user_input", "confirm": "individual", "required": false,
          "hint_ko": "예약 확인서 주소를 보고 목록에서 골라 주세요" },
        { "key": "stay.sub_district", "selector": null, "widget": "assist",
          "labels": { "ko": "동·세부 지역", "en": "Sub-District, Sub-Area" }, "source": "user_input", "confirm": "individual", "required": false,
          "hint_ko": "예약 확인서 주소를 보고 목록에서 골라 주세요" },
        { "key": "stay.post_code", "selector": "[formcontrolname=\"accPostCode\"]", "widget": "text",
          "labels": { "ko": "숙소 우편번호 (5자리)", "en": "Post Code" }, "source": "user_input", "confirm": "individual", "required": false },
        { "key": "stay.address", "selector": "[formcontrolname=\"accAddress\"]", "widget": "text", "transform": "upper",
          "labels": { "ko": "숙소 주소 (영문)", "en": "Address" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "예약 확인서에 적힌 영문 주소를 그대로" }
      ]
    },
    {
      "id": "health",
      "title_ko": "건강 신고",
      "probe": "[formcontrolname=\"yellowFever\"]",
      "note_ko": "황열 예방 접종 증명서, 몸 상태 같은 건강 질문은 앱이 대신 답하지 않아요. 사이트에서 직접 답해 주세요.",
      "fields": []
    }
  ],
  "checkpoints": [
    { "id": "captcha", "kind": "captcha", "selector": "iframe[src*=\"challenges.cloudflare.com\"]", "ko": "사람인지 확인하는 칸이 나오면 직접 눌러 주세요" },
    { "id": "health", "kind": "health", "selector": "[formcontrolname=\"yellowFever\"]", "ko": "건강 질문은 직접 답해 주세요" },
    { "id": "declaration", "kind": "declaration", "selector": "[formcontrolname=\"checkedDecalraion\"]", "ko": "내용이 맞다는 약속이에요. 직접 읽고 체크해 주세요" },
    { "id": "email", "kind": "email", "selector": "[formcontrolname=\"sendTo\"]", "ko": "확인 메일을 받을 주소를 직접 적어 주세요" },
    { "id": "final_submit", "kind": "final_submit", "selector": "button[type=\"submit\"]", "ko": "마지막 'Submit'은 직접 눌러 주세요" }
  ],
  "options": {
    "purpose": [
      { "value": "tourism", "ko": "관광", "en": "Tourism", "local": "ท่องเที่ยว", "site": "HOLIDAY" },
      { "value": "business", "ko": "출장", "en": "Business", "local": "ธุรกิจ", "site": "BUSINESS" },
      { "value": "meeting", "ko": "회의", "en": "Meeting", "site": "MEETING" },
      { "value": "medical", "ko": "치료·건강", "en": "Medical & wellness", "site": "MEDICAL & WELLNESS" },
      { "value": "education", "ko": "공부", "en": "Education", "site": "EDUCATION" }
    ],
    "stay_type": [
      { "value": "hotel", "ko": "호텔", "en": "Hotel", "site": "HOTEL" },
      { "value": "guest_house", "ko": "게스트하우스", "en": "Guest house", "site": "GUEST HOUSE" },
      { "value": "hostel", "ko": "유스호스텔", "en": "Youth hostel", "site": "YOUTH HOSTEL" },
      { "value": "apartment", "ko": "아파트·레지던스", "en": "Apartment", "site": "APARTMENT" },
      { "value": "friend", "ko": "친구 집", "en": "Friend's house", "site": "FRIEND'S HOUSE" }
    ]
  }
}
