{
  "schema_version": 1,
  "form_id": "TW_TWAC",
  "version": "2026.10.02-1",
  "last_verified": "2026-10-02",
  "site_version_seen": "Last updated on July 29, 2026",
  "sources": [
    { "id": "twac_site", "name": "대만 이민서 TWAC(첫 화면·자주 묻는 질문은 화면에서, 입력 칸 이름·선택지 글자는 공개 앱 코드와 공개 번역 파일에서 확인, 인증·제출하지 않음)", "url": "https://twac.immigration.gov.tw/" }
  ],
  "source": "twac_site",
  "official_url_patterns": ["https://twac.immigration.gov.tw/*"],
  "start_url": "https://twac.immigration.gov.tw/",
  "labels_reviewed": false,
  "steps": [
    {
      "id": "email",
      "title_ko": "이메일 인증",
      "probe": "input[name=\"email\"]",
      "note_ko": "첫 화면에서 'Submit Arrival Card(입국신고서 제출하기)'를 눌러 시작해요. 메일로 온 인증 코드는 직접 적어요.",
      "fields": [
        { "key": "profile.email", "selector": "input[name=\"email\"]", "widget": "text",
          "labels": { "ko": "이메일", "en": "Email" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "인증 코드와 확인 메일을 받을 주소" }
      ]
    },
    {
      "id": "traveler",
      "title_ko": "입국자 정보",
      "probe": "#traveler1_passportNo",
      "fields": [
        { "key": "trip.arrival_date", "selector": "#traveler1_expectEntryDate", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "대만 도착 날짜", "en": "Date of Entry Taiwan" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "trip.departure_date", "selector": "#traveler1_intendedDepartureDate", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "대만에서 떠나는 날짜", "en": "Expected Departure Taiwan Date" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "passport.full_name_given_first", "selector": "#traveler1_englishName", "widget": "text", "transform": "upper",
          "labels": { "ko": "영문 이름 (이름 다음 성)", "en": "English Name" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.number", "selector": "#traveler1_passportNo", "widget": "text", "transform": "upper",
          "labels": { "ko": "여권 번호", "en": "Passport Number" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.expiry_date", "selector": "#traveler1_passportExpiryDate", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "여권 만료일", "en": "Date of Passport Expiry" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "passport.gender", "selector": null, "widget": "assist",
          "labels": { "ko": "성별", "en": "Sex" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "성별 버튼은 직접 눌러 주세요" },
        { "key": "passport.birth_date", "selector": "#traveler1_birthDate", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "생년월일", "en": "Date of Birth" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "passport.nationality", "selector": "#traveler1_nation", "widget": "assist",
          "labels": { "ko": "국적", "en": "Nationality" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "목록에서 대한민국을 찾아 골라 주세요" },
        { "key": "profile.country_birth", "selector": "#traveler1_birthPlace1", "widget": "assist",
          "labels": { "ko": "태어난 나라", "en": "Country/ Place of Birth" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "대한민국", "hint_ko": "목록에서 골라 주세요" },
        { "key": "profile.city_res", "selector": "#traveler1_livingCity", "widget": "assist",
          "labels": { "ko": "사는 곳", "en": "Place of Residence" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "목록에서 사는 곳을 골라 주세요" },
        { "key": "trip.visa_type", "selector": "#traveler1_visaTypeRadio", "widget": "assist",
          "labels": { "ko": "비자 종류", "en": "Visa Type" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "visa_type", "default_value": "exempt", "hint_ko": "버튼은 직접 눌러 주세요" },
        { "key": "profile.phone_code", "selector": "#traveler1_phoneCountryCode", "widget": "assist",
          "labels": { "ko": "전화 나라 번호", "en": "Country/ Region Code" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "82", "hint_ko": "목록에서 골라 주세요" },
        { "key": "profile.phone", "selector": "#traveler1_phoneNumber", "widget": "text",
          "labels": { "ko": "휴대폰 번호", "en": "Mobile Number" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "숫자만 적어 주세요" },
        { "key": "profile.occupation", "selector": "#traveler1_occupation", "widget": "select",
          "labels": { "ko": "직업", "en": "Occupation" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "occupation" }
      ]
    },
    {
      "id": "trip",
      "title_ko": "여행 일정",
      "probe": "#traveler1_reason",
      "note_ko": "들어올 때·나갈 때 모두 '비행기(Air)'를 먼저 골라 주세요.",
      "fields": [
        { "key": "trip.flight_prefix", "selector": "#traveler1_arrivalFlightCode", "widget": "assist",
          "labels": { "ko": "들어오는 항공사 코드", "en": "Expected Entry Flight Code" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "목록에서 이 항공사 코드를 골라 주세요" },
        { "key": "trip.flight_digits", "selector": "#traveler1_arrivalFlightNumber", "widget": "text",
          "labels": { "ko": "들어오는 편명 숫자", "en": "Expected Entry Flight Number" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "항공사 코드를 고르면 이 칸이 비워져요. 코드를 고른 다음에 채워요" },
        { "key": "trip.departure_flight_no", "selector": "#traveler1_departureFlightCode", "widget": "assist",
          "labels": { "ko": "나가는 항공편", "en": "Expected Departure Flight" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "항공사 코드는 목록에서 고르고, 편명 숫자는 옆 칸에 적어 주세요" },
        { "key": "trip.purpose", "selector": "#traveler1_reason", "widget": "select",
          "labels": { "ko": "방문 목적", "en": "Purpose of Visit" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "purpose" },
        { "key": "stay.address", "selector": "#traveler1_address", "widget": "text",
          "labels": { "ko": "호텔 이름 또는 숙소 주소 (영문)", "en": "Hotel Name / Residential Address" }, "source": "user_input", "confirm": "individual", "required": true,
          "hint_ko": "사이트에서 '호텔 이름'이나 '거주 주소' 버튼을 먼저 고르면 칸이 나와요" }
      ]
    }
  ],
  "checkpoints": [
    { "id": "email_code", "kind": "email", "selector": "input[name=\"verifyCode\"]", "ko": "메일로 받은 인증 코드는 직접 적어 주세요" },
    { "id": "address_check", "kind": "declaration", "selector": "#traveler1_addrDeclaration", "ko": "주소가 맞는지 보고 직접 체크해 주세요" },
    { "id": "declaration", "kind": "declaration", "selector": "input[name=\"declarationCheck\"]", "ko": "선언문을 읽고 직접 체크해 주세요" },
    { "id": "final_submit", "kind": "final_submit", "selector": null, "ko": "마지막 'SUBMIT(제출)'은 직접 눌러 주세요" }
  ],
  "options": {
    "visa_type": [
      { "value": "exempt", "ko": "비자 없이 (무비자)", "en": "Visa-Exempt", "site": "Visa-Exempt(include TAC)" },
      { "value": "holding", "ko": "비자가 있어요", "en": "Holding a Visa", "site": "Holding a Visa" }
    ],
    "occupation": [
      { "value": "employee", "ko": "회사원", "en": "Clerk/Employee/Staff", "site": "職員/CLERK/EMPLOYEE/STAFF" },
      { "value": "business", "ko": "사업·경영", "en": "Business/Director/CEO", "site": "商/執行長/總裁/BUSINESS/DIRECTOR/CEO" },
      { "value": "student", "ko": "학생", "en": "Student", "site": "學生/STUDENT/SCHOLAR/PUPIL" },
      { "value": "homemaker", "ko": "주부", "en": "Homemaker", "site": "家庭照顧者/HOMEMAKER" },
      { "value": "teacher", "ko": "교사", "en": "Teacher/Educator", "site": "教師/TEACHER/EDUCATOR" },
      { "value": "government", "ko": "공무원", "en": "Government officer", "site": "公務員/GOVERNMENT OFFICER" },
      { "value": "it", "ko": "IT 직군", "en": "IT", "site": "資訊人員/IT" },
      { "value": "engineer", "ko": "엔지니어·건축가", "en": "Engineer/Architect", "site": "工程師/建築師/ENGINEER/ARCHITECH" },
      { "value": "doctor", "ko": "의사·치과의사", "en": "Doctor/Dentist", "site": "醫生/DOCTOR/DENTIST" },
      { "value": "nurse", "ko": "간호사", "en": "Nurse", "site": "護士/看護婦/NURSE" },
      { "value": "none", "ko": "무직·아기", "en": "None/Baby/Infant", "site": "無業/NONE/BABY/INFANT" },
      { "value": "other", "ko": "그 밖의 직업", "en": "Other", "site": "其他/OTHER" }
    ],
    "purpose": [
      { "value": "tourism", "ko": "관광", "en": "Sightseeing", "site": "3.觀光 Sightseeing / Travel / Leisure" },
      { "value": "business", "ko": "출장", "en": "Business", "site": "1.商務 Business" }
    ]
  }
}
