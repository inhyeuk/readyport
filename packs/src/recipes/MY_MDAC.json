{
  "schema_version": 1,
  "form_id": "MY_MDAC",
  "version": "2026.09.28-2",
  "last_verified": "2026-09-28",
  "site_version_seen": "registerMain",
  "sources": [
    { "id": "mdac_site", "name": "말레이시아 이민국 MDAC 등록 화면(실기기에서 구조·선택지 확인, 제출하지 않음)", "url": "https://imigresen-online.imi.gov.my/mdac/main?registerMain" }
  ],
  "source": "mdac_site",
  "official_url_patterns": ["https://imigresen-online.imi.gov.my/mdac/*"],
  "start_url": "https://imigresen-online.imi.gov.my/mdac/main?registerMain",
  "labels_reviewed": false,
  "steps": [
    {
      "id": "all",
      "title_ko": "입국 카드",
      "probe": "#passNo",
      "fields": [
        { "key": "passport.full_name_surname_first", "selector": "#name", "widget": "assist", "transform": "upper",
          "labels": { "ko": "이름 (여권에 적힌 그대로)", "en": "Name" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "여권에 적힌 영문 이름을 그대로 적어 주세요" },
        { "key": "passport.number", "selector": "#passNo", "widget": "text", "transform": "upper",
          "labels": { "ko": "여권 번호", "en": "Passport No." }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.birth_date", "selector": "#dob", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "생년월일", "en": "Date of Birth" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "passport.nationality", "selector": "#nationality", "widget": "select",
          "site_map": { "KOR": "KOR - REPUBLIC OF KOREA" },
          "labels": { "ko": "국적", "en": "Nationality" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "profile.country_birth", "selector": "#pob", "widget": "select",
          "site_map": { "대한민국": "KOR - REPUBLIC OF KOREA" },
          "labels": { "ko": "태어난 나라", "en": "Place of Birth" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "대한민국" },
        { "key": "passport.gender", "selector": "#sex", "widget": "select",
          "site_map": { "M": "MALE", "F": "FEMALE" },
          "labels": { "ko": "성별", "en": "Sex" }, "source": "passport", "confirm": "bulk", "required": true },
        { "key": "passport.expiry_date", "selector": "#passExpDte", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "여권 만료일", "en": "Passport Expiry Date" }, "source": "passport", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "profile.email", "selector": "#email", "widget": "text",
          "labels": { "ko": "이메일", "en": "Email" }, "source": "user_input", "confirm": "individual", "required": true },
        { "key": "profile.email_confirm", "selector": "#confirmEmail", "widget": "text",
          "labels": { "ko": "이메일 한 번 더", "en": "Confirm Email" }, "source": "user_input", "confirm": "bulk", "required": false },
        { "key": "profile.phone_code", "selector": "#region", "widget": "select",
          "site_map": { "82": "( 82 ) SOUTH KOREA" },
          "labels": { "ko": "전화 나라 번호", "en": "Region" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "82" },
        { "key": "profile.phone", "selector": "#mobile", "widget": "text",
          "labels": { "ko": "휴대폰 번호", "en": "Mobile No." }, "source": "user_input", "confirm": "individual", "required": true },
        { "key": "trip.arrival_date", "selector": "#arrDt", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "도착 날짜", "en": "Arrival Date" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "trip.departure_date", "selector": "#depDt", "widget": "assist", "transform": "date_dmy",
          "labels": { "ko": "떠나는 날짜", "en": "Departure Date" }, "source": "booking", "confirm": "bulk", "required": true,
          "hint_ko": "달력에서 골라 주세요" },
        { "key": "trip.flight_no", "selector": "#vesselNm", "widget": "text", "transform": "upper",
          "labels": { "ko": "편명", "en": "Flight/Vessel/Transportation No." }, "source": "booking", "confirm": "bulk", "required": true },
        { "key": "trip.arrival_mode", "selector": "#trvlMode", "widget": "select", "site_value": "AIR",
          "labels": { "ko": "오는 방법", "en": "Mode of Travel" }, "source": "booking", "confirm": "bulk", "required": true },
        { "key": "trip.country_board", "selector": "#embark", "widget": "select",
          "site_map": { "대한민국": "KOR - REPUBLIC OF KOREA" },
          "labels": { "ko": "출발한 나라", "en": "Last Port of Embarkation" }, "source": "user_input", "confirm": "individual", "required": true,
          "default_value": "대한민국" },
        { "key": "stay.type", "selector": "#accommodationStay", "widget": "select",
          "labels": { "ko": "숙소 종류", "en": "Accommodation of Stay" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "stay_type" },
        { "key": "stay.address", "selector": "#accommodationAddress1", "widget": "text", "transform": "upper",
          "labels": { "ko": "숙소 주소 (영문)", "en": "Address (In Malaysia)" }, "source": "booking", "confirm": "bulk", "required": true },
        { "key": "stay.state", "selector": "#accommodationState", "widget": "select",
          "labels": { "ko": "숙소가 있는 주", "en": "State" }, "source": "user_choice", "confirm": "individual", "required": true,
          "options_ref": "my_state" },
        { "key": "stay.city", "selector": "#accommodationCity", "widget": "assist",
          "labels": { "ko": "숙소가 있는 도시", "en": "City" }, "source": "user_input", "confirm": "individual", "required": false,
          "hint_ko": "주를 고르면 나오는 목록에서 골라 주세요" },
        { "key": "stay.post_code", "selector": "#accommodationPostcode", "widget": "text",
          "labels": { "ko": "숙소 우편번호 (5자리)", "en": "Postcode" }, "source": "user_input", "confirm": "individual", "required": true }
      ]
    }
  ],
  "checkpoints": [
    { "id": "captcha", "kind": "captcha", "selector": "iframe[src*=\"recaptcha\"]", "ko": "사람인지 확인하는 칸이 나오면 직접 눌러 주세요" },
    { "id": "final_submit", "kind": "final_submit", "selector": "#submit", "ko": "마지막 'Submit'은 직접 눌러 주세요" }
  ],
  "options": {
    "stay_type": [
      { "value": "hotel", "ko": "호텔·모텔", "en": "Hotel/Motel", "site": "HOTEL/MOTEL/REST HOUSE" },
      { "value": "friend", "ko": "친구·친척 집", "en": "Friends/Relatives", "site": "RESIDENCE OF FRIENDS/RELATIVES" },
      { "value": "other", "ko": "그 밖의 숙소", "en": "Others", "site": "OTHERS" }
    ],
    "my_state": [
      { "value": "kl", "ko": "쿠알라룸푸르", "en": "Kuala Lumpur", "site": "WP KUALA LUMPUR" },
      { "value": "selangor", "ko": "셀랑고르", "en": "Selangor", "site": "SELANGOR" },
      { "value": "penang", "ko": "페낭", "en": "Pulau Pinang", "site": "PULAU PINANG" },
      { "value": "johor", "ko": "조호르", "en": "Johor", "site": "JOHOR" },
      { "value": "melaka", "ko": "말라카", "en": "Melaka", "site": "MELAKA" },
      { "value": "sabah", "ko": "사바(코타키나발루)", "en": "Sabah", "site": "SABAH" },
      { "value": "sarawak", "ko": "사라왁", "en": "Sarawak", "site": "SARAWAK" },
      { "value": "pahang", "ko": "파항", "en": "Pahang", "site": "PAHANG" },
      { "value": "kedah", "ko": "크다(랑카위)", "en": "Kedah", "site": "KEDAH" }
    ]
  }
}
